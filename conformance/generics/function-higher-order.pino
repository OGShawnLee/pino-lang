# covers: GEN-5, GEN-6
@@Generic[T, U]
fn map_all(list []T, transform fn (T) -> U) []U {
  var out = []U
  for x in list {
    out:push(transform(x))
  }
  return out
}

val numbers = [1, 2, 3]
val strings = map_all[int, string](numbers, fn(n int) -> "n" + str(n))
val doubled = map_all(numbers, fn(n int) -> n * 2)
println(strings:join(","))
println(doubled:join(","))
