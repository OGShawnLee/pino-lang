# covers: GEN-8
interface DocumentShape {
  name string
}

@generic[Doc is DocumentShape]
struct Library {
  catalog map[string, Doc]
}

struct Book {
  name string
}

val lib = Library[Book] {
  catalog: map[string, Book] { "a": Book { name: "Dune" } }
}
val catalog = lib:catalog
println(catalog["a"]:name)
