# covers: UNION-6, UNION-8
@@Generic[T]
union Maybe {
  Some(T)
  None
}

val o1 = Maybe::Some(42)
var o2 Maybe[int] = Maybe::None

match o1 {
  when Maybe::Some(v) { println("Some:" + str(v)) }
  else { println("none") }
}
match o2 {
  when Maybe::Some(v) { println("Some:" + str(v)) }
  when Maybe::None { println("None") }
}
