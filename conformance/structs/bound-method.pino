# covers: STRUCT-14
struct Worker {
  factor int

  fn add(n int) int {
    return n + factor
  }
}

struct Mutator {
  mut value int

  mut fn increment() {
    value = value + 1
  }
}

val w = Worker { factor: 10 }
val bound = w:add
println(bound(5))

var m = Mutator { value: 42 }
val inc = fn () { m:increment() }
inc()
inc()
println(m:value)
