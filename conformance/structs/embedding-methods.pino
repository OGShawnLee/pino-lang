# covers: STRUCT-9
struct Character {
  name string
  mut hp   int

  mut fn take_damage(dmg int) {
    self:hp -= dmg
    println("$name took $dmg damage.")
  }
}

struct Hero {
  Character
  mana int
}

var warrior = Hero {
  name: "Guts",
  hp: 150,
  mana: 20
}

warrior:take_damage(30)
println(warrior:hp)
println(warrior:mana)
