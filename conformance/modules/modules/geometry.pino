module Geometry

pub struct Point {
  x int
  y int
}

pub fn add_coords(p Point) int {
  return p:x + p:y
}

pub fn add(a int, b int) int {
  return a + b
}

pub fn greet(name string) string {
  return "hello $name"
}

struct Secret {
  value int
}

interface Hidden {
  fn area() int
}

pub struct Square {
  side int

  fn area() int {
    return side * side
  }
}
