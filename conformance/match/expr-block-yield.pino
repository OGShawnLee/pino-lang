# covers: MATCH-6, MATCH-8
val level = 3
val label = match level {
  when 1 => "Beginner"
  when 2 => "Intermediate"
  else {
    println("Advanced level detected")
    yield "Expert"
  }
}
println(label)

val picked = match 1 {
  when 1 {
    yield 20
  }
  else {
    println("not reached")
    yield 0
  }
}
println(picked)
