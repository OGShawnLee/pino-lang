# covers: VEC-6
var matrix = [][]int
val row = []int
matrix:push(row)
if row in matrix {
  println("row in matrix")
}
var map_list = []map[string, int]
val one = map[string, int] { "one" -> 1 }
map_list:push(one)
println(map_list[0]["one"])
var fn_list = []fn (int) -> int
val int_fn = fn (n int) -> n
fn_list:push(int_fn)
if int_fn in fn_list {
  println("fn in list")
}
