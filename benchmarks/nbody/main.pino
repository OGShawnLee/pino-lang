struct Body {
  mut x float
  mut y float
  mut z float
  mut vx float
  mut vy float
  mut vz float
  mass float
}

fn my_sqrt(x float) float {
  var g = x * 0.5 + 1.0
  for 16 {
    g = 0.5 * (g + x / g)
  }
  return g
}

fn round_int(v float) int {
  if v >= 0.0 {
    return int(v + 0.5)
  }
  return int(v - 0.5)
}

fn advance(mut bodies []Body, dt float) {
  val n = bodies:len
  var i = 0
  for i < n {
    var j = i + 1
    for j < n {
      val dx = bodies[i]:x - bodies[j]:x
      val dy = bodies[i]:y - bodies[j]:y
      val dz = bodies[i]:z - bodies[j]:z
      val dsq = dx * dx + dy * dy + dz * dz
      val dist = my_sqrt(dsq)
      val mag = dt / (dsq * dist)

      val mi = bodies[i]:mass
      val mj = bodies[j]:mass

      bodies[i]:vx -= dx * mj * mag
      bodies[i]:vy -= dy * mj * mag
      bodies[i]:vz -= dz * mj * mag

      bodies[j]:vx += dx * mi * mag
      bodies[j]:vy += dy * mi * mag
      bodies[j]:vz += dz * mi * mag

      j += 1
    }
    i += 1
  }

  var k = 0
  for k < n {
    bodies[k]:x += dt * bodies[k]:vx
    bodies[k]:y += dt * bodies[k]:vy
    bodies[k]:z += dt * bodies[k]:vz
    k += 1
  }
}

fn energy(bodies []Body) float {
  var e = 0.0
  val n = bodies:len
  var i = 0
  for i < n {
    val bi = bodies[i]
    e += 0.5 * bi:mass * (bi:vx * bi:vx + bi:vy * bi:vy + bi:vz * bi:vz)
    var j = i + 1
    for j < n {
      val bj = bodies[j]
      val dx = bi:x - bj:x
      val dy = bi:y - bj:y
      val dz = bi:z - bj:z
      val dist = my_sqrt(dx * dx + dy * dy + dz * dz)
      e -= (bi:mass * bj:mass) / dist
      j += 1
    }
    i += 1
  }
  return e
}

fn main {
  val quick = file_exists("benchmarks/data/quick")
  val steps = if quick then 3000 else 15000

  val pi = 3.141592653589793
  val solar_mass = 4.0 * pi * pi
  val days_per_year = 365.24

  var bodies = [
    Body {
      x: 0.0, y: 0.0, z: 0.0,
      vx: 0.0, vy: 0.0, vz: 0.0,
      mass: solar_mass
    }
    Body {
      x: 4.84143144246472090,
      y: -1.16032004402742839,
      z: -0.103622044471123109,
      vx: 0.00166007664274403694 * days_per_year,
      vy: 0.00769901118419740425 * days_per_year,
      vz: -0.0000690460016972063023 * days_per_year,
      mass: 0.000954791938424326609 * solar_mass
    }
    Body {
      x: 8.34336671824457987,
      y: 4.12479856412430479,
      z: -0.403523417114321381,
      vx: -0.00276742510726862411 * days_per_year,
      vy: 0.00499852801234917238 * days_per_year,
      vz: 0.0000230417297573763929 * days_per_year,
      mass: 0.000285885980666130812 * solar_mass
    }
    Body {
      x: 12.8943695621391310,
      y: -15.1111514016986312,
      z: -0.223307578892655734,
      vx: 0.00296460137564761618 * days_per_year,
      vy: 0.00237847173959480950 * days_per_year,
      vz: -0.0000296589568540237556 * days_per_year,
      mass: 0.0000436624404335156298 * solar_mass
    }
    Body {
      x: 15.3796971148509165,
      y: -25.9193146099879641,
      z: 0.179258772950371181,
      vx: 0.00268067772490389322 * days_per_year,
      vy: 0.00162824170038242295 * days_per_year,
      vz: -0.0000951592254519715870 * days_per_year,
      mass: 0.0000515138902046611451 * solar_mass
    }
  ]

  var px = 0.0
  var py = 0.0
  var pz = 0.0
  for b in bodies {
    px += b:vx * b:mass
    py += b:vy * b:mass
    pz += b:vz * b:mass
  }
  bodies[0]:vx = -px / solar_mass
  bodies[0]:vy = -py / solar_mass
  bodies[0]:vz = -pz / solar_mass

  val e0 = energy(bodies)
  for steps {
    advance(mut bodies, 0.01)
  }
  val e1 = energy(bodies)

  println(round_int(e0 * 1000000000.0))
  println(round_int(e1 * 1000000000.0))
}
