fn fib(n int) int {
  if n < 2 {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

fn main {
  val quick = file_exists("benchmarks/data/quick")
  val n = if quick then 25 else 29
  val t0 = time()
  val ans = fib(n)
  val bench_ms = time() - t0
  println(ans)
  println("PINO_BENCH_MS=$bench_ms")
}
