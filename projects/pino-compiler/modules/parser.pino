module Parser

from Lexer import lex
from Entities import 
  Program,
  AST,
  Declaration,
  Parameter,
  Type,
  Primitive,
  When,
  Statement,
  Loop,
  Pattern,
  Field,
  Argument,
  Expression,
  BinaryOperator,
  UnaryOperator,
  Constant,
  Token,
  TokenType,
  Literal,
  TokenStream,
  Property

val PRECEDENCE_MAP = map[string, int] {
  "::": 100
  ":": 100
	"*": 50
	"/": 50
	"%": 50
	"+": 45
	"-": 45
	"<": 35
	"<=": 35
	">": 35
	">=": 35
	"!=": 30
	"==": 30
	"and": 10
	"or": 5
	"=": 1
}

val BINARY_OPERATOR_MAP = map[string, BinaryOperator] {
  "+": BinaryOperator::Add
  "-": BinaryOperator::Subtract
  "*": BinaryOperator::Multiply
  "/": BinaryOperator::Divide
  "%": BinaryOperator::Remainder
  "and": BinaryOperator::And
  "or": BinaryOperator::Or
  "==": BinaryOperator::Equal
  "!=": BinaryOperator::NotEqual
  "<=": BinaryOperator::LessOrEqual
  ">=": BinaryOperator::GreaterOrEqual
  "<": BinaryOperator::LessThan
  ">": BinaryOperator::GreaterThan
  "=": BinaryOperator::Assign
  "::": BinaryOperator::StaticMemberAccess
  ":": BinaryOperator::MemberAccess
}

val UNARY_OPERATOR_MAP = map[string, UnaryOperator] {
  "-": UnaryOperator::Negate
  "not": UnaryOperator::Not
}

fn is_unary_operator(token Token) bool {
  return token:type == TokenType::UnaryOperator and token:value in UNARY_OPERATOR_MAP
}

fn is_binary_operator(token Token) bool {
  # DO NOT CHECK TOKEN TYPE BECAUSE '-' IS LEXED AS UNARY OP BUT IS INCLUDED IN THE MAP
  return token:value in BINARY_OPERATOR_MAP
}

fn get_precedence(token Token) int {
  if token:value in PRECEDENCE_MAP {
    return PRECEDENCE_MAP[token:value]
  }

  panic("Expected precedence for token $(token:value).")
}

fn parse_unary_operator(token Token) Result[UnaryOperator, string] {
  if not is_unary_operator(token) {
    return Result::Failure("Expected unary operator. Got $(token:value).")
  }

  return Result::Success(UNARY_OPERATOR_MAP[token:value])
}

fn parse_binary_operator(token Token) Result[BinaryOperator, string] {
  if not is_binary_operator(token) {
    return Result::Failure("Expected binary operator. Got $(token:value).")
  }

  return Result::Success(BINARY_OPERATOR_MAP[token:value])
}

fn parse_arg_list(stream TokenStream) Result[[]Argument, string] {
  val arg_list = []Argument

  if stream:peek(0):value == "," {
    return Result::Failure("Expected argument before ',' in argument list.")
  }

  for {
    val curr = stream:peek(0)

    if curr:value == ")" {
      break
    }

    if curr:value == "," {
      if stream:peek(1):value == "," {
        return Result::Failure("Expected argument before consecutive ',' in argument list.")
      }

      if stream:peek(1):value == ")" {
        return Result::Failure("Expected argument before ')' in argument list.")
      }

      stream:next()
      continue
    }

    if stream:peek(0):value == "@" {
      stream:next()
      
      val name = stream:expect_type(TokenType::Identifier)?:value
    
      if stream:peek(0):value == ":" {
        stream:next()

        val expr = parse_expr(stream, 0, true)?
    
        arg_list:push(Argument::Label(name, expr))
      } else {
        arg_list:push(Argument::Label(name, Expression::Var(name)))
      }

      continue
    }

    val arg_expr = parse_expr(stream, 0, true)?
    arg_list:push(Argument::Expression(arg_expr))
  }

  stream:expect_content(")")?

  return Result::Success(arg_list)
}

fn parse_literal(value string, literal Literal) Result[Constant, string] {
  match literal {
    when Literal::Int {
      return Result::Success(Constant::Int(int(value)?))
    }
    when Literal::Float {
      return Result::Success(Constant::Float(float(value)?))
    }
    when Literal::Bool {
      return Result::Success(Constant::Bool(value == "true"))
    }
    else {
      return Result::Failure("Expected Constant Literal. Got $(value).")
    }
  }
}

fn parse_list(stream TokenStream) Result[Expression, string] {
  val expr_list = []Expression

  for {
    val curr = stream:peek(0)

    if curr:type == TokenType::EOF or curr:value == "]" {
      break
    }

    if curr:value == "," {
      if stream:peek(1):value == "]" {
        return Result::Failure("Expected expression before ']' in list. Tip: Remove trailing ',' from list.")
      }

      stream:next()
      continue
    }

    val expr = parse_expr(stream, 0, true)?
    expr_list:push(expr)
  } 

  stream:expect_content("]")?

  var list_type = Type::Implicit

  if expr_list:len == 0 {
    list_type = parse_type(stream)?
  }

  return Result::Success(Expression::List(expr_list, list_type))
}

fn parse_struct_instance(stream TokenStream, struct_name string) Result[Expression, string] {
  if not is_capital(struct_name) {
    return Result::Failure("Expected struct instance name to be capitalized. Got '$struct_name'.")
  }

  stream:expect_content("{")?

  val property_map = map[string, Expression] {}

  for {
    val curr = stream:peek(0)

    if curr:type == TokenType::EOF or curr:value == "}" {
      break
    }

    if curr:value == "," {
      if stream:peek(1):value == "}" {
        return Result::Failure("Syntax Error: Expected property before '}' in struct instance '$struct_name'. Tip: Remove trailing ',' from struct instance '$struct_name'.")
      }

      stream:next()
      continue
    }

    val property_name = stream:expect_type(TokenType::Identifier)?:value
    
    if property_name in property_map {
      return Result::Failure("Expected unique property name. Got '$property_name' repeated in struct instance '$struct_name'.")
    }

    if stream:peek(0):value == ":" {
      stream:next()
      val property_expr = parse_expr(stream, 0, true)?
      property_map[property_name] = property_expr
    } else {
      property_map[property_name] = Expression::Var(property_name)
    }
  } 

  stream:expect_content("}") or {
    return Result::Failure("Syntax Error: Expected '}' to close struct instance '$struct_name'.")
  }

  return Result::Success(Expression::StructInstance(struct_name, property_map))
}

fn is_struct_init_lookahead(stream TokenStream) {
  return 
    stream:peek(0):value == "{" and 
    stream:peek(1):type == TokenType::Identifier and 
    (stream:peek(2):value == ":" or stream:peek(2):value == "," or stream:peek(2):value == "}")
}

fn parse_factor(stream TokenStream, is_struct_instance_allowed bool) Result[Expression, string] {
  val curr = stream:consume()
  match curr:type {
    when TokenType::Literal(literal) {
      val const_literal = parse_literal(curr:value, literal)?
      return Result::Success(Expression::Constant(const_literal))
    }
    when TokenType::UnaryOperator {
      val operator = parse_unary_operator(curr)?
      val expr = parse_factor(stream, is_struct_instance_allowed)?
      return Result::Success(Expression::Unary(operator, expr))
    }
    when TokenType::Marker {
      if curr:value == "[" {
        return parse_list(stream)
      }

      if curr:value != "(" {
        return Result::Failure("Unable to Parse factor. Expected '(' Marker. Got '$(curr:value)'.")
      }

      val inner_expr = parse_expr(stream, 0, true)?
      stream:expect_content(")")?

      return Result::Success(inner_expr)
    }
    when TokenType::Keyword {
      if curr:value == "if" {
        val condition = parse_expr(stream, 0, true)?
        stream:expect_content("then")?
        val then_branch = parse_expr(stream, 0, true)?
        stream:expect_content("else")?
        val else_branch = parse_expr(stream, 0, true)?

        return Result::Success(Expression::Conditional(condition, then_branch, else_branch))
      }

      if curr:value == "fn" {
        val param_list = if stream:peek(0):value == "("
          then parse_fn_param_list(stream, true)?
          else []Parameter

        if stream:peek(0):value == "->" {
          stream:next()
          val expr = parse_expr(stream, 0, true)?
          val block = [AST::Statement(Statement::Return(expr))]
          
          return Result::Success(Expression::Lambda(param_list, Type::Implicit, block, false))
        } else {
          val block = parse_block(stream, true)?
          
          return Result::Success(Expression::Lambda(param_list, Type::Implicit, block, false))
        }
      }

      return Result::Failure("Unexpected keyword '$(curr:value)' inside factor.")
    }
    when TokenType::Identifier {
      if stream:peek(0):value == "(" {
        stream:next()
        val arg_list = parse_arg_list(stream)?
        return Result::Success(Expression::FunctionCall(curr:value, arg_list))
      }

      if is_capital(curr:value) and stream:peek(0):value == "{" {
        if is_struct_init_lookahead(stream) or is_struct_instance_allowed { 
          val struct_instance = parse_struct_instance(stream, curr:value)?
          return Result::Success(struct_instance)
        }

        return Result::Success(Expression::Var(curr:value))
      }

      return Result::Success(Expression::Var(curr:value))
    }
    else {
      return Result::Failure("Expected literal. Got $(curr:value).")
    }
  }
}

fn parse_postfix(left_expr Expression, stream TokenStream) Result[Expression, string] {
  var expr = left_expr

  for {
    if stream:peek(0):value == "[" {
      stream:next()
      
      val index_expr = parse_expr(stream, 0, true)?
      
      stream:expect_content("]")?

      expr = Expression::Index(expr, index_expr)
      continue
    }

    break
  }

  return Result::Success(expr)
}

@pub_testing
fn parse_expr(stream TokenStream, min_prec int, is_struct_instance_allowed bool) Result[Expression, string] {
  var left = parse_factor(stream, is_struct_instance_allowed)?

  for {
    left = parse_postfix(left, stream)?

    val curr = stream:peek(0)

    if curr:type == TokenType::EOF {
      break
    }
    
    if is_binary_operator(curr) and get_precedence(curr) >= min_prec {
      val operator = parse_binary_operator(stream:consume())?

      if operator == BinaryOperator::Assign {
        val right = parse_expr(stream, get_precedence(curr), is_struct_instance_allowed)?
        left = Expression::Assignment(left, right)
        continue
      }

      val right = if operator == BinaryOperator::MemberAccess or operator == BinaryOperator::StaticMemberAccess then
        parse_factor(stream, is_struct_instance_allowed)?
      else 
        parse_expr(stream, get_precedence(curr) + 1, is_struct_instance_allowed)?

      left = Expression::Binary(operator, left, right)
    } else {
      break
    }
  }

  return Result::Success(left)
}

@pub_testing
fn parse_when_case(stream TokenStream) Result[When, string] {
  stream:expect_content("when")?

  val cond_list = []Expression
  for {
    val curr = stream:peek(0)

    if curr:type == TokenType::EOF or curr:value == "{" {
      break
    }
    
    if curr:value == "," {
      stream:next()

      if stream:peek(0):value == "," {
        return Result::Failure("Expected expression before ',' in when branch.")
      }

      continue
    }

    val condition_expr = parse_expr(stream, 0, false)?
    cond_list:push(condition_expr)
  }

  if cond_list:len == 0 {
    return Result::Failure("Expected at least one condition in when branch.")
  }

  val block = parse_block(stream, true)?
  
  return Result::Success(When { cond_list: cond_list, block: block })
}

fn parse_loop_stmt(stream TokenStream) Result[Statement, string] {
  stream:expect_content("for")?

  if stream:peek(0):value == "{" {
    val block = parse_block(stream, true)?
    return Result::Success(
      Statement::Loop(
        Loop::Infinite(block)
      )
    )
  }

  val iterator_expr = parse_expr(stream, 0, false)?

  if stream:peek(0):value == "{" {
    val block = parse_block(stream, true)?
    return Result::Success(
      Statement::Loop(
        Loop::While(iterator_expr, block)
      )
    )
  }

  if stream:peek(0):value == "in" {
    if iterator_expr is Expression::Var(value_var) {
      stream:next()

      val iterable_expr = parse_expr(stream, 0, false)?
      val block = parse_block(stream, true)?

      return Result::Success(
        Statement::Loop(
          Loop::ForIn(value_var, iterable_expr, block)
        )
      )
    }

    return Result::Failure("Syntax Error: Expected identifier for 'value' in for-in loop: 'for <value> in <iterable-expr> { ... }'.")
  }

  stream:expect_content(",")?

  val value_var = stream:expect_type(TokenType::Identifier)?:value
  
  if iterator_expr is Expression::Var(key_var) {
    stream:expect_content("in")?

    val iterable_expr = parse_expr(stream, 0, false)?
    val block = parse_block(stream, true)?

    return Result::Success(
      Statement::Loop(
        Loop::PairForIn(key_var, value_var, iterable_expr, block)
      )
    )
  }

  return Result::Failure("Syntax Error: Expected identifier for 'key' in pair for-in loop: 'for <key>, <value> in <iterable-expr> { ... }.")
}

@pub_testing
fn parse_match_stmt(stream TokenStream) Result[Statement, string] {
  stream:expect_content("match")?
  val condition = parse_expr(stream, 0, false)?
  stream:expect_content("{")?


  val when_case_list = []When
  var else_branch_list = [][]AST

  for {
    val curr = stream:peek(0)
    
    if curr:type == TokenType::EOF or curr:value == "}" {
      break
    }

    if curr:value == "when" {
      val when_case = parse_when_case(stream)?
      when_case_list:push(when_case)
      continue
    }

    if curr:value == "else" {
      stream:next()
      val else_block = parse_block(stream, true)?
      else_branch_list:push(else_block)
  
      if else_branch_list:len > 1 {
        return Result::Failure("Expected at most one else branch in match statement.")
      }

      continue
    }

    return Result::Failure(
      "Expected only multiple when branches or one else branch inside a match statement. Instead got '$(curr:value)'."
    )
  }

  stream:expect_content("}")?

  return Result::Success(
    Statement::Match(
      condition,
      when_case_list,
      if else_branch_list:len > 0 then
        Option::Some(else_branch_list[0])
      else
        Option::None
    )
  )
}

@pub_testing
fn parse_stmt(stream TokenStream) Result[Statement, string] {
  val curr = stream:peek(0)

  match curr:value {
    when "return" {
      stream:next()
      val expr = parse_expr(stream, 0, true)?
      return Result::Success(Statement::Return(expr))
    }
    when "if" {
      stream:next()
      val condition = parse_expr(stream, 0, false)?
      val then_branch = parse_stmt(stream)?

      if stream:peek(0):value == "else" {
        stream:next()
        val else_branch = parse_stmt(stream)?
        return Result::Success(Statement::If(condition, then_branch, Option::Some(else_branch)))
      }

      return Result::Success(Statement::If(condition, then_branch, Option::None))
    }
    when "for" {
      return parse_loop_stmt(stream)
    }
    when "continue" {
      stream:next()
      return Result::Success(Statement::Continue)
    }
    when "break" {
      stream:next()
      return Result::Success(Statement::Break)
    }
    when "match" {
      return parse_match_stmt(stream)
    }
    when "{" {
      val block = parse_block(stream, true)?
      return Result::Success(Statement::Compound(block))
    }
    else {
      val expr = parse_expr(stream, 0, true)?
      return Result::Success(Statement::Expression(expr))
    }
  }
}

fn is_capital(line string) bool {
  val first_char = line[0]
  return first_char >= 'A' and first_char <= 'Z'
}

fn parse_enum_decl(stream TokenStream) Result[Declaration, string] {
  stream:expect_content("enum")?

  val name_token = stream:expect_type(TokenType::Identifier) or {
    val curr = stream:peek(0)
    return Result::Failure("Expected enum name, instead got '$(curr:value)'. Tip: Add an enum name before '{'.")
  }

  val name = name_token:value

  if not is_capital(name) {
    return Result::Failure("Expected capitalized name for enum '$name'. Tip: Capitalize enum names.")
  }

  stream:expect_content("{") or {
    val curr = stream:peek(0)
    return Result::Failure("Expected '{' after enum name '$name', instead got '$(curr:value)'. Tip: Add '{' after enum name '$name'.")
  }

  val constant_list = []string
  for {
    val curr = stream:peek(0)
   
    if curr:type == TokenType::EOF or curr:value == "}" {
      break
    }

    if curr:value == "," {
      stream:next()
      
      if stream:peek(0):value == "," {
        return Result::Failure("Expected identifier before ',' in enum '$name'. Tip: Avoid consecutive commas in enum declaration.")
      }
      
      continue
    }

    val enum_constant = stream:expect_type(TokenType::Identifier) or {
      val curr = stream:peek(0)
      return Result::Failure("Expected enum constant name in enum '$name'. Got '$(curr:value)'. Tip: An enum constant is a capitalized identifier.")
    }

    if enum_constant:value in constant_list {
      return Result::Failure("Duplicate enum constant '$(enum_constant:value)' in enum '$name'. Tip: Enum constants must be unique.")
    }

    if not is_capital(enum_constant:value) {
      return Result::Failure("Expected capitalized constant in enum '$name'. Got '$(enum_constant:value)'. Tip: Capitalize enum constants.")
    }

    constant_list:push(enum_constant:value)
  }

  if constant_list:len == 0 {
    return Result::Failure("Expected at least one constant inside enum '$name' declaration. Tip: Add at least one constant to the '$name' enum.")
  }

  stream:expect_content("}") or {
    val curr = stream:peek(0)
    return Result::Failure("Expected '}' after enum '$name' constants. Got '$(curr:value)'. Tip: Add '}' after the last enum constant in '$name'.")
  }

  return Result::Success(Declaration::EnumDeclaration(name, constant_list))
}

fn parse_var_or_val_decl(stream TokenStream) Result[Declaration, string] {
  val curr = stream:consume()

  if curr:value != "val" and curr:value != "var" {
    return Result::Failure("Expected 'val' or 'var' keyword. Got '$(curr:value)'.")
  }

  val name_token = stream:expect_type(TokenType::Identifier)?
  stream:expect_content("=")?
  val expr = parse_expr(stream, 0, true)?

  return Result::Success(
    if curr:value == "val" then
      Declaration::ConstantDeclaration(name_token:value, expr, Type::Implicit)
    else
      Declaration::VariableDeclaration(name_token:value, expr, Type::Implicit)
  )
}

fn parse_fn_type(stream TokenStream) Result[Type, string] {
  val param_type_list = []Parameter

  if stream:peek(0):value == "(" {
    stream:next()

    for {
      val curr = stream:peek(0)

      if curr:type == TokenType::EOF or curr:value == ")" {
        break
      }

      if curr:value == "," {
        stream:next()
        continue
      }

      val type = parse_type(stream)?
      param_type_list:push(Parameter { name: "", type: type, default_expr: Option::None })
    }

    stream:expect_content(")")?
  }

  var return_type = Type::Void

  if stream:peek(0):value == "->" {
    stream:next()
    return_type = parse_type(stream)?
  }

  return Result::Success(Type::Function(param_type_list, return_type))
}

fn parse_type(stream TokenStream) Result[Type, string] {
  if stream:peek(0):value == "[" {
    stream:next()
    stream:expect_content("]")?
    val list_type = parse_type(stream)?
    return Result::Success(Type::List(list_type))
  }

  if stream:peek(0):value == "fn" {
    stream:next()
    return parse_fn_type(stream)
  }

  val type_token = stream:expect_type(TokenType::Identifier) or {
    val curr = stream:peek(0)
    return Result::Failure("Expected type identifier. Got '$(curr:value)'.")
  }

  return match type_token:value {
    when "int" => Result::Success(Type::Primitive(Primitive::Int))
    when "float" => Result::Success(Type::Primitive(Primitive::Float))
    when "bool" => Result::Success(Type::Primitive(Primitive::Bool))
    when "void" => Result::Success(Type::Void)
    else => Result::Success(Type::Pending(type_token:value))
  }
}

fn parse_fn_param_list(stream TokenStream, is_lambda bool) Result[[]Parameter, string] {
  stream:expect_content("(")?

  if stream:peek(0):value == "," {
    return Result::Failure("Expected parameter name or ')' before ',' in parameter list.")
  }

  var param_list = []Parameter

  for {
    val curr = stream:peek(0)

    if curr:value == ")" or curr:type == TokenType::EOF {
      break
    }

    if curr:value == "," {
      if (stream:peek(1):value == ",") or (not is_lambda and stream:peek(2):value == ")") {
        return Result::Failure("Expected parameter name after ',' in parameter list.")
      }

      stream:next()
      continue
    }

    val name = stream:expect_type(TokenType::Identifier)?
    val default_expr = match stream:peek(0):value {
      when "=" {
        stream:next()
        yield Option::Some(parse_expr(stream, 0, true)?)
      }
      else => Option::None
    }

    if is_lambda and stream:peek(0):value == "," or stream:peek(0):value == ")" {
      param_list:push(
        Parameter { 
          name: name:value, 
          type: Type::Implicit, 
          default_expr: default_expr 
        }
      )
      continue
    }

    val type = if default_expr is Option::None then parse_type(stream)? else Type::Implicit

    param_list:push(
      Parameter { 
        name: name:value, 
        type: type, 
        default_expr: default_expr 
      }
    )
  }

  stream:expect_content(")")?

  return Result::Success(param_list)
}

@pub_testing
fn parse_fn_decl(stream TokenStream) Result[Declaration, string] {
  stream:expect_content("fn")?
  val name_token = stream:expect_type(TokenType::Identifier)?
  val param_list = if stream:peek(0):value == "(" 
    then parse_fn_param_list(stream, false)? 
    else []Parameter
  val ret_type = if stream:peek(0):value == "{" 
    then Type::Implicit
    else parse_type(stream)?
  val block = parse_block(stream, true)?

  return Result::Success(
    Declaration::FunctionDeclaration(
      name_token:value, 
      param_list,
      ret_type,
      block
    )
  )
}

fn parse_pattern_field_list(stream TokenStream) Result[[]Field, string] {
  stream:expect_content("(")?

  val field_list = []Field

  for {
    val curr = stream:peek(0)

    if curr:value == ")" or curr:type == TokenType::EOF {
      break
    }

    if curr:value == "," {
      if stream:peek(1):value == "," or stream:peek(2):value == ")" {
        return Result::Failure("Expected field name after ',' in pattern field list.")
      }

      stream:next()
      continue
    }

    val name = stream:expect_type(TokenType::Identifier)?
    val type = parse_type(stream)?

    field_list:push(
      Field { 
        name: name:value, 
        type: type 
      }
    )
  }

  stream:expect_content(")")?

  return Result::Success(field_list)
}

fn parse_pattern(stream TokenStream, union_name string, index_map map[string, int]) Result[Pattern, string] {
  val pattern_name = stream:expect_type(TokenType::Identifier)?:value
  
  if not is_capital(pattern_name) {
    return Result::Failure("Expected capitalized identifier for pattern name of union '$union_name', got '$pattern_name'. Tip: Capitalize pattern names.")
  }

  if pattern_name in index_map {
    return Result::Failure("Duplicate pattern '$pattern_name' in union '$union_name'. Tip: Patterns must be unique within the same union.")
  }

  val curr = stream:peek(0)

  if curr:value == "(" {
    val field_list = parse_pattern_field_list(stream)?
    return Result::Success(Pattern {
      name: pattern_name
      field_list: field_list
    })
  } else {
    return Result::Success(Pattern {
      name: pattern_name
      field_list: []Field
    })
  }
}

fn parse_union_decl(stream TokenStream) Result[Declaration, string] {
  stream:expect_content("union")?

  val union_name = stream:expect_type(TokenType::Identifier)?:value

  if not is_capital(union_name) {
    return Result::Failure("Expected capitalized identifier for union name, got '$union_name'. Tip: Capitalize union names.")
  }

  val pattern_list = []Pattern
  val index_map = map[string, int] {}

  stream:expect_content("{")?

  for {
    val curr = stream:peek(0)

    if curr:type == TokenType::EOF or curr:value == "}" {
      break
    }

    val pattern = parse_pattern(stream, union_name, index_map)?
    
    index_map[pattern:name] = pattern_list:len
    pattern_list:push(pattern)    
  }

  if pattern_list:len == 0 {
    return Result::Failure("Expected at least one pattern inside union '$union_name' declaration. Tip: Add at least one pattern to the '$union_name' union.")
  }

  stream:expect_content("}")?

  return Result::Success(Declaration::UnionDeclaration(union_name, pattern_list, index_map))
}

fn parse_property(stream TokenStream) Result[Property, string] {
  var is_public = false

  if stream:peek(0):value == "pub" {
    stream:next()
    is_public = true
  }

  val name = stream:expect_type(TokenType::Identifier)?:value
  val type = parse_type(stream)?

  return Result::Success(Property { name: name, type: type, is_public: is_public })
}

fn parse_struct_decl(stream TokenStream) Result[Declaration, string] {
  stream:expect_content("struct")

  val struct_name = stream:expect_type(TokenType::Identifier)?:value

  if not is_capital(struct_name) {
    return Result::Failure("Expected capitalized identifier for struct name, got '$struct_name'. Tip: Capitalize struct names.")
  }

  val property_map = map[string, Property] {}

  stream:expect_content("{")?

  for {
    val curr = stream:peek(0)

    if curr:type == TokenType::EOF or curr:value == "}" {
      break
    }

    val property = parse_property(stream)?

    if property:name in property_map {
      return Result::Failure("Duplicate property '$(property:name)' in struct '$struct_name'. Tip: Properties must be unique within the same struct.")
    }

    property_map[property:name] = property
  }

  stream:expect_content("}")?

  return Result::Success(Declaration::StructDeclaration(struct_name, property_map))
}

fn parse_interface_decl(stream TokenStream) Result[Declaration, string] {
  stream:expect_content("interface")

  val interface_name = stream:expect_type(TokenType::Identifier)?:value

  if not is_capital(interface_name) {
    return Result::Failure("Expected capitalized identifier for interface name, got '$interface_name'. Tip: Capitalize interface names.")
  }

  val property_map = map[string, Property] {}

  stream:expect_content("{")?

  for {
    val curr = stream:peek(0)

    if curr:type == TokenType::EOF or curr:value == "}" {
      break
    }

    val property = parse_property(stream)?

    if property:name in property_map {
      return Result::Failure("Duplicate property '$(property:name)' in interface '$interface_name'. Tip: Properties must be unique within the same interface.")
    }

    property_map[property:name] = property
  }

  stream:expect_content("}")?

  return Result::Success(Declaration::InterfaceDeclaration(interface_name, property_map))
}

@pub_testing
fn parse_decl(stream TokenStream) Result[Declaration, string] {
  val curr = stream:peek(0)
  match curr:value {
    when "fn" {
      val res = parse_fn_decl(stream)?
      return Result::Success(res)
    }
    when "val", "var" {
      val res = parse_var_or_val_decl(stream)?
      return Result::Success(res)
    }
    when "enum" {
      val res = parse_enum_decl(stream)?
      return Result::Success(res)
    }
    when "union" {
      val res = parse_union_decl(stream)?
      return Result::Success(res)
    }
    when "struct" {
      val res = parse_struct_decl(stream)?
      return Result::Success(res)
    }
    when "interface" {
      val res = parse_interface_decl(stream)?
      return Result::Success(res)
    }
    else {
      return Result::Failure("Expected 'fn', 'var', 'val', 'enum', 'union' or 'interface' keyword. Got $(curr:value).")
    }
  }
}

fn parse_block_item(stream TokenStream) Result[AST, string] {
  val curr = stream:peek(0)
  match curr:value {
    when "fn", "var", "val", "enum", "union", "struct", "interface" {
      val decl = parse_decl(stream)?
      return Result::Success(AST::Declaration(decl))
    }
    else {
      val stmt = parse_stmt(stream)?
      return Result::Success(AST::Statement(stmt))
    }
  }
}

@pub_testing 
fn parse_block(stream TokenStream, as_block bool) Result[[]AST, string] {
  if as_block {
    stream:expect_content("{")?
  }

  val block_list = []AST

  for {
    val curr = stream:peek(0) 

    if curr:type == TokenType::EOF {
      break
    }

    if as_block and curr:value == "}" {
      break
    }

    val block_item = parse_block_item(stream)?
    block_list:push(block_item)
  }

  if as_block {
    stream:expect_content("}")?
  }

  return Result::Success(block_list)
}

pub fn parse(list []Token) Result[Program, string] {
  val stream = TokenStream { list: list, cursor: 0 }
  val program = Program { 
    content: parse_block(stream, false)?
  }
  return Result::Success(program)
}

@pub_testing
fn parse_line(line string) {
  val list = lex(line)
  return parse(list)
}
