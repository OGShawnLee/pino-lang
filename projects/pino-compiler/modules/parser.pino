module Parser

from Lexer import Token, TokenType, lex

pub struct TokenStream {
  list []Token
  cursor int

  fn peek(offset int) {
    if cursor + offset >= list:len {
      return Token { type: TokenType::EOF, value: "" }
    }

    return list[cursor + offset]
  }

  fn next {
    cursor += 1
  }

  fn consume {
    val curr = this:peek(0)
    this:next()
    return curr
  }

  fn expect_type(type TokenType) Result[Token, string] {
    val curr = this:peek(0)

    if curr:type == type {
      this:next()
      return Result::Success(curr)
    }

    return Result::Failure("Expected type $type, but got $(curr:type).")
  }

  fn expect_content(content string) Result[Token, string] {
    val curr = this:peek(0)

    if curr:value == content {
      this:next()
      return Result::Success(curr)
    }

    return Result::Failure("Expected '$content', but got '$(curr:value)'.")
  }

  fn print {
    for token in list {
      token:print()
    }
  }
}

pub enum UnaryOperator {
  Negate
  Not
}

pub enum BinaryOperator {
  Add
  Subtract
  Multiply
  Divide
  Remainder
  And
  Or
  Equal
  NotEqual
  LessThan
  LessOrEqual
  GreaterThan
  GreaterOrEqual
  Assign
  Conditional
}

pub union Expression {
  Constant(int)
  Var(string)
  Unary(UnaryOperator, Expression)
  Binary(BinaryOperator, Expression, Expression)
  Assignment(Expression, Expression)
  Conditional(Expression, Expression, Expression)
}

pub union Statement {
  Return(Expression)
}

pub union Typing {
  Explicit(string)
  Implicit
}

pub struct Parameter {
  name string
  type string
}

pub union Declaration {
  FunctionDeclaration(string, []Parameter, Typing, []AST)
  ConstantDeclaration(string, Expression)
  VariableDeclaration(string, Expression)
}

pub union AST {
  Declaration(Declaration)
  Statement(Statement)
  Expression(Expression)
}

pub struct Program {
  children []AST

  fn print {
    println("Program")
    for child in children {
      Program::print_ast(child)
    }
  }

  static fn print_ast(node AST) {
    match node {
      when AST::Declaration(decl) {
        Program::print_ast_decl(decl)
      }
      when AST::Statement(stmt) {
        Program::print_ast_stmt(stmt)
      }
      when AST::Expression(expr) {
        Program::print_ast_expr(expr)
      }
    }
  }

  static fn print_ast_decl(decl Declaration) {
    match decl {
      when Declaration::FunctionDeclaration(name, param_list, ret_type, children) {
        println("Function: $name")

        if param_list:len > 0 {
          println("Parameters: ")
          for param in param_list {
            println(param)
          }
        }

        val ret_type_str = match ret_type {
          when Typing::Explicit(type_name) => type_name
          when Typing::Implicit => "Implicit"
        }

        println("Return Type: $ret_type_str")
        for child in children {
          Program::print_ast(child)
        }
      }
      when Declaration::VariableDeclaration(name, expr) {
        println("Variable: $name")
        Program::print_ast_expr(expr)
      }
      when Declaration::ConstantDeclaration(name, expr) {
        println("Constant Variable: $name")
        Program::print_ast_expr(expr)
      }
    }
  }

  static fn print_ast_stmt(stmt Statement) {
    match stmt {
      when Statement::Return(expr) {
        println("Return:")
        Program::print_ast_expr(expr)
      }
    }
  }

  static fn print_ast_expr(expr Expression) {
    match expr {
      when Expression::Constant(integer) {
        println("Constant: $integer")
      }
      when Expression::Var(name) {
        println("Var: $name")
      }
      when Expression::Conditional(condition, then_branch, else_branch) {
        println("Conditional:")
        println("If:")
        Program::print_ast_expr(condition)
        println("Then:")
        Program::print_ast_expr(then_branch)
        println("Else:")
        Program::print_ast_expr(else_branch)
      }
      when Expression::Unary(op, expr) {
        println("Unary: $op")
        Program::print_ast_expr(expr)
      }
      when Expression::Binary(op, left, right) {
        println("Binary: $op")
        Program::print_ast_expr(left)
        Program::print_ast_expr(right)
      }
      when Expression::Assignment(left, right) {
        println("Assignment")
        Program::print_ast_expr(left)
        Program::print_ast_expr(right)
      }
    }
  }
}

val PRECEDENCE_MAP = map[string, int] {
	"*": 50
	"/": 50
	"%": 50
	"+": 45
	"-": 45
	"<": 35
	"<=": 35
	">": 35
	">=": 35
	"!=": 30
	"==": 30
	"and": 10
	"or": 5
	"=": 1
}

val BINARY_OPERATOR_MAP = map[string, BinaryOperator] {
  "+": BinaryOperator::Add
  "-": BinaryOperator::Subtract
  "*": BinaryOperator::Multiply
  "/": BinaryOperator::Divide
  "%": BinaryOperator::Remainder
  "and": BinaryOperator::And
  "or": BinaryOperator::Or
  "==": BinaryOperator::Equal
  "!=": BinaryOperator::NotEqual
  "<=": BinaryOperator::LessOrEqual
  ">=": BinaryOperator::GreaterOrEqual
  "<": BinaryOperator::LessThan
  ">": BinaryOperator::GreaterThan
  "=": BinaryOperator::Assign
}

val UNARY_OPERATOR_MAP = map[string, UnaryOperator] {
  "-": UnaryOperator::Negate
  "not": UnaryOperator::Not
}

fn is_unary_operator(token Token) bool {
  return token:type == TokenType::UnaryOperator and token:value in UNARY_OPERATOR_MAP
}

fn is_binary_operator(token Token) bool {
  # DO NOT CHECK TOKEN TYPE BECAUSE '-' IS LEXED AS UNARY OP BUT IS INCLUDED IN THE MAP
  return token:value in BINARY_OPERATOR_MAP
}

fn get_precedence(token Token) int {
  if token:value in PRECEDENCE_MAP {
    return PRECEDENCE_MAP[token:value]
  }

  panic("Expected precedence for token $(token:value).")
}

fn parse_unary_operator(token Token) Result[UnaryOperator, string] {
  if not is_unary_operator(token) {
    return Result::Failure("Expected unary operator. Got $(token:value).")
  }

  return Result::Success(UNARY_OPERATOR_MAP[token:value])
}

fn parse_binary_operator(token Token) Result[BinaryOperator, string] {
  if not is_binary_operator(token) {
    return Result::Failure("Expected binary operator. Got $(token:value).")
  }

  return Result::Success(BINARY_OPERATOR_MAP[token:value])
}

fn parse_factor(stream TokenStream) Result[Expression, string] {
  val curr = stream:consume()
  match curr:type {
    when TokenType::Literal {
      return Result::Success(Expression::Constant(int(curr:value)?))
    }
    when TokenType::UnaryOperator {
      val operator = parse_unary_operator(curr)?
      val expr = parse_factor(stream)?
      return Result::Success(Expression::Unary(operator, expr))
    }
    when TokenType::Marker {
      if curr:value != "(" {
        return Result::Failure("Unable to Parse factor. Expected '(' Marker. Got '$(curr:value)'.")
      }

      val inner_expr = parse_expr(stream, 0)?
      stream:expect_content(")")?

      return Result::Success(inner_expr)
    }
    when TokenType::Keyword {
      if curr:value != "if" {
        return Result::Failure("Unexpected keyword '$(curr:value)' inside factor.")
      }

      val condition = parse_expr(stream, 0)?
      stream:expect_content("then")?
      val then_branch = parse_expr(stream, 0)?
      stream:expect_content("else")?
      val else_branch = parse_expr(stream, 0)?

      return Result::Success(Expression::Conditional(condition, then_branch, else_branch))
    }
    when TokenType::Identifier {
      return Result::Success(Expression::Var(curr:value))
    }
    else {
      return Result::Failure("Expected literal. Got $(curr:value).")
    }
  }
}

fn parse_expr(stream TokenStream, min_prec int) Result[Expression, string] {
  var left = parse_factor(stream)?

  for {
    val curr = stream:peek(0)

    if curr:type == TokenType::EOF {
      break
    }
    
    if is_binary_operator(curr) and get_precedence(curr) >= min_prec {
      val operator = parse_binary_operator(stream:consume())?

      if operator == BinaryOperator::Assign {
        val right = parse_expr(stream, get_precedence(curr))?
        left = Expression::Assignment(left, right)
        continue
      }

      val right = parse_expr(stream, get_precedence(curr) + 1)?
      left = Expression::Binary(operator, left, right)
    } else {
      break
    }
  }

  return Result::Success(left)
}

fn parse_stmt(stream TokenStream) Result[Statement, string] {
  val curr = stream:consume()

  match curr:value {
    when "return" {
      val expr = parse_expr(stream, 0)?
      return Result::Success(Statement::Return(expr))
    }
    else {
      return Result::Failure("Expected 'return' keyword. Got $(curr:value).")
    }
  }
}

fn parse_var_or_val_decl(stream TokenStream) Result[Declaration, string] {
  val curr = stream:consume()

  if curr:value != "val" and curr:value != "var" {
    return Result::Failure("Expected 'val' or 'var' keyword. Got '$(curr:value)'.")
  }

  val name_token = stream:expect_type(TokenType::Identifier)?
  stream:expect_content("=")?
  val expr = parse_expr(stream, 0)?

  return Result::Success(
    if curr:value == "val" then
      Declaration::ConstantDeclaration(name_token:value, expr)
    else
      Declaration::VariableDeclaration(name_token:value, expr)
  )
}

fn parse_fn_ret_type(stream TokenStream) Result[Typing, string] {
  val curr = stream:peek(0)

  return match curr:type {
    when TokenType::Identifier => Result::Success(Typing::Explicit(stream:consume():value))
    when TokenType::Marker => 
      if curr:value == "{"
        then Result::Success(Typing::Implicit)
        else Result::Failure("Expected Identifier for return type. Got '$(curr:value)'.")
    else => Result::Failure("Expected Identifier for return type. Got '$(curr:value)'.")
  }
}

fn parse_fn_parameter_list(stream TokenStream) Result[[]Parameter, string] {
  stream:expect_content("(")?

  if stream:peek(0):value == "," {
    return Result::Failure("Expected parameter name or ')' before ',' in parameter list.")
  }

  var parameter_list = []Parameter

  for {
    val curr = stream:peek(0)

    if curr:value == ")" or curr:type == TokenType::EOF {
      break
    }

    if curr:value == "," {
      if stream:peek(1):value == "," or stream:peek(2):value == ")" {
        return Result::Failure("Expected parameter name after ',' in parameter list.")
      }

      stream:next()
      continue
    }

    val name = stream:expect_type(TokenType::Identifier)?
    val type = stream:expect_type(TokenType::Identifier)?

    parameter_list:push(Parameter { name: name:value, type: type:value })
  }

  stream:expect_content(")")?

  return Result::Success(parameter_list)
}

fn parse_fn_decl(stream TokenStream) Result[Declaration, string] {
  stream:expect_content("fn")?
  val name_token = stream:expect_type(TokenType::Identifier)?
  val parameter_list = if stream:peek(0):value == "(" 
    then parse_fn_parameter_list(stream)? 
    else []Parameter
  val ret_type = parse_fn_ret_type(stream)?
  val fn_ast = parse_ast(stream, true)?

  return Result::Success(
    Declaration::FunctionDeclaration(
      name_token:value, 
      parameter_list,
      ret_type,
      fn_ast
    )
  )
}

fn parse_decl(stream TokenStream) Result[Declaration, string] {
  val curr = stream:peek(0)
  match curr:value {
    when "fn" {
      val res = parse_fn_decl(stream)?
      return Result::Success(res)
    }
    when "val", "var" {
      val res = parse_var_or_val_decl(stream)?
      return Result::Success(res)
    }
    else {
      return Result::Failure("Expected 'fn', 'var' or 'val' keyword. Got $(curr:value).")
    }
  }
}

fn parse_ast(stream TokenStream, as_block bool) Result[[]AST, string] {
  if as_block {
    stream:expect_content("{")?
  }

  val ast_list = []AST

  for {
    val curr = stream:peek(0)

    if curr:type == TokenType::EOF or (as_block and curr:value == "}") {
      break
    }

    match curr:value {
      when "fn", "var", "val" {
        ast_list:push(AST::Declaration(parse_decl(stream)?))
      }
      when "return" {
        ast_list:push(AST::Statement(parse_stmt(stream)?))
      }
      else {
        val expr = parse_expr(stream, 0)?
        ast_list:push(AST::Expression(expr))
      }
    }
  }

  if as_block {
    stream:expect_content("}")?
  }

  return Result::Success(ast_list)
}

pub fn parse(list []Token) Result[Program, string] {
  val stream = TokenStream { list: list, cursor: 0 }
  val program = Program { 
    children: parse_ast(stream, false)?
  }
  return Result::Success(program)
}

pub fn parse_line(line string) {
  val list = lex(line)
  return parse(list)
}

test "AST: Should parse a Program with multiple top-level declarations and expressions" {
  val program = parse_line("val a = 12 var b = 20 b = b + 10 fn add int { val double_n = a * 2 return double_n + b }")
  assert program == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::ConstantDeclaration("a", Expression::Constant(12))),
        AST::Declaration(Declaration::VariableDeclaration("b", Expression::Constant(20))),
        AST::Expression(Expression::Assignment(
          Expression::Var("b"),
          Expression::Binary(BinaryOperator::Add, Expression::Var("b"), Expression::Constant(10))
        )),
        AST::Declaration(Declaration::FunctionDeclaration("add", []Parameter, Typing::Explicit("int"), [
          AST::Declaration(Declaration::ConstantDeclaration(
            "double_n",
            Expression::Binary(
              BinaryOperator::Multiply,
              Expression::Var("a"),
              Expression::Constant(2)
            )
          )),
          AST::Statement(Statement::Return(
            Expression::Binary(
              BinaryOperator::Add,
              Expression::Var("double_n"),
              Expression::Var("b")
            )
          ))
        ]))
      ]
    }
  )
}

test "AST: Should parse a block of multiple declarations and expressions" {
  val content = "{ val a = 10 var b = 20 b = b + 10 val c = a - b }"
  val list = lex(content)
  val stream = TokenStream { list: list, cursor: 0 }
  val block = parse_ast(stream, true)
  assert block == Result::Success([
    AST::Declaration(Declaration::ConstantDeclaration("a", Expression::Constant(10))),
    AST::Declaration(Declaration::VariableDeclaration("b", Expression::Constant(20))),
    AST::Expression(Expression::Assignment(
      Expression::Var("b"),
      Expression::Binary(BinaryOperator::Add, Expression::Var("b"), Expression::Constant(10))
    )),
    AST::Declaration(Declaration::ConstantDeclaration(
      "c", 
      Expression::Binary(
        BinaryOperator::Subtract,
        Expression::Var("a"),
        Expression::Var("b")
      )
    ))
  ])
}

test "Declaration: Should parse a var declaration" {
  val program = parse_line("var n = 2")
  assert program == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::VariableDeclaration("n", Expression::Constant(2)))
      ]
    }
  )
}

test "Declaration: Should parse a val declaration" {
  val program = parse_line("val n = 2")
  assert program == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::ConstantDeclaration("n", Expression::Constant(2)))
      ]
    }
  )
}

test "Declaration: Should parse a fn declaration (no parameter-list, explicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main int { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      []Parameter,
      Typing::Explicit("int"),
      [
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]
    )
  )
}

test "Declaration: Should parse a fn declaration (no parameter-list, implicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      []Parameter,
      Typing::Implicit,
      [
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]
    )
  )
}

test "Declaration: Should parse a fn declaration (empty parameter-list, explicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main() int { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      []Parameter,
      Typing::Explicit("int"),
      [
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]
    )
  )
}


test "Declaration: Should parse a fn declaration (empty parameter-list, implicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main() { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      []Parameter,
      Typing::Implicit,
      [
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]
    )
  )
}

test "Declaration: Should parse a fn declaration (parameter-list, explicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main(a int, b int) int { return a + b }"), 
      cursor: 0 
    }
  )

  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      [
        Parameter { name: "a", type: "int" },
        Parameter { name: "b", type: "int" }
      ],
      Typing::Explicit("int"),
      [
        AST::Statement(Statement::Return(
          Expression::Binary(BinaryOperator::Add, Expression::Var("a"), Expression::Var("b"))
        ))
      ]
    )
  )
}

test "Declaration: Should parse a fn declaration (parameter-list, implicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main(a int, b int) { return a + b }"), 
      cursor: 0 
    }
  )

  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      [
        Parameter { name: "a", type: "int" },
        Parameter { name: "b", type: "int" }
      ],
      Typing::Implicit,
      [
        AST::Statement(Statement::Return(
          Expression::Binary(BinaryOperator::Add, Expression::Var("a"), Expression::Var("b"))
        ))
      ]
    )
  )
}

test "Expression: Should parse a parse a binary expression" {
  val content = "12 + 2"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Binary(
      BinaryOperator::Add,
      Expression::Constant(12),
      Expression::Constant(2)
    )
  )
}

test "Expression: Should parse a parse a higher precedence binary expression" {
  val content = "12 + 2 * 2"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Binary(
      BinaryOperator::Add,
      Expression::Constant(12),
      Expression::Binary(
        BinaryOperator::Multiply,
        Expression::Constant(2),
        Expression::Constant(2)
      )
    )
  )
}

test "Expression: Should parse a parse a unary expression" {
  val content = "12 + -2"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Binary(
      BinaryOperator::Add,
      Expression::Constant(12),
      Expression::Unary(
        UnaryOperator::Negate,
        Expression::Constant(2)
      )
    )
  )
}

test "Expression: Should parse a parse a parenthesized expression" {
  val content = "(12 + 2)"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Binary(
      BinaryOperator::Add,
      Expression::Constant(12),
      Expression::Constant(2)
    )
  )
}

test "Expression: Should parse a parse a higher precedence parenthesized expression" {
  val content = "(12 + 2) * 2"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Binary(
      BinaryOperator::Multiply,
      Expression::Binary(
        BinaryOperator::Add,
        Expression::Constant(12),
        Expression::Constant(2)
      ),
      Expression::Constant(2)
    )
  )
}

test "Expression: Should parse a conditional expression" {
  val content = "if 12 > 0 then 2 else 1"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Conditional(
      Expression::Binary(
        BinaryOperator::GreaterThan,
        Expression::Constant(12),
        Expression::Constant(0)
      ),
      Expression::Constant(2),
      Expression::Constant(1)
    )
  )
}