test "Identifier Resolution: Should allow redeclaration of function in new scope" {
  val program = parse_line("fn a {} fn main { fn a {} }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::FunctionDeclaration("a", []Parameter, Typing::Implicit, []AST)),
        AST::Declaration(Declaration::FunctionDeclaration("main", []Parameter, Typing::Implicit, [
          AST::Declaration(Declaration::FunctionDeclaration("a", []Parameter, Typing::Implicit, []AST))
        ]))
      ]
    }
  )
}

test "Identifier Resolution: Should allow redeclaration of function as variable in new scope" {
  val program = parse_line("fn a {} fn main { var a = 12 }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::FunctionDeclaration("a", []Parameter, Typing::Implicit, []AST)),
        AST::Declaration(Declaration::FunctionDeclaration("main", []Parameter, Typing::Implicit, [
          AST::Declaration(Declaration::VariableDeclaration("a_0", Expression::Constant(12)))
        ]))
      ]
    }
  )
}

test "Identifier Resolution: Should allow redeclaration of function as constant in new scope" {
  val program = parse_line("fn a {} fn main { val a = 12 }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::FunctionDeclaration("a", []Parameter, Typing::Implicit, []AST)),
        AST::Declaration(Declaration::FunctionDeclaration("main", []Parameter, Typing::Implicit, [
          AST::Declaration(Declaration::ConstantDeclaration("a_0", Expression::Constant(12)))
        ]))
      ]
    }
  )
}

test "Identifier Resolution: Should allow redeclaration of constant in new scope" {
  val program = parse_line("val a = 12 fn main { val a = 10 return a }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::ConstantDeclaration("a_0", Expression::Constant(12))),
        AST::Declaration(Declaration::FunctionDeclaration("main", []Parameter, Typing::Implicit, [
          AST::Declaration(Declaration::ConstantDeclaration("a_1", Expression::Constant(10))),
          AST::Statement(Statement::Return(Expression::Var("a_1")))
        ]))
      ]
    }
  )
}

test "Identifier Resolution: Should allow redeclaration of variable in new scope" {
