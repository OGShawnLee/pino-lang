test "Identifier Resolution: Should catch redeclaring a parameter in the same function scope as a parameter" {
  val program = parse_line("fn a(b int, b int) {}") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Failure("Type Checker Error: Parameter 'b' has been already declared in the current scope.")
}

