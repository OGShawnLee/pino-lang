  val program = parse_line("val a = 12 fn a {}") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Failure("Type Checker Error: Constant 'a' has been already declared in the current scope.")
