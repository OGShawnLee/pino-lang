module Checker

from Entities import 
  Program,
  AST,
  Declaration,
  Parameter,
  Statement,
  Expression,
  BinaryOperator,
  UnaryOperator

struct Entity {
  unique_name string
  is_from_current_block bool
}

struct Counter {
  count int

  fn increment {
    count += 1
  }

  fn reset {
    count = 0
  }
}

@pub_testing
val pseudo_name_counter = Counter { count: 0 }

fn generate_pseudonym(name string) string {
	val new_name = "$(name)_$(pseudo_name_counter:count)"
	pseudo_name_counter:increment()
	return new_name
}

fn copy_variable_map(variable_map map[string, Entity]) map[string, Entity] {
	val new_variable_map = map[string, Entity] {}
	for name, entity in variable_map {
		new_variable_map[name] = Entity {
			unique_name: entity:unique_name,
			is_from_current_block: false
		}
	}
	return new_variable_map
}

fn resolve_expr(expr Expression, variable_map map[string, Entity]) Result[Expression, string] {
  match expr {
    when Expression::Constant(integer) {
      return Result::Success(Expression::Constant(integer))
    }
    when Expression::Var(name) {
      if name in variable_map {
        return Result::Success(Expression::Var(variable_map[name]:unique_name))
      }

      return Result::Failure("Type Checker Error: Variable '$name' has not been declared in the current scope.")
    }
    when Expression::Unary(un_operator, expr) {
      val resolved_expr = resolve_expr(expr, variable_map)?

      return Result::Success(Expression::Unary(un_operator, resolved_expr))
    }
    when Expression::Binary(bin_operator, left_expr, right_expr) {
      val resolved_left_expr = resolve_expr(left_expr, variable_map)?
      val resolved_right_expr = resolve_expr(right_expr, variable_map)?

      return Result::Success(Expression::Binary(bin_operator, resolved_left_expr, resolved_right_expr))
    }
    when Expression::Assignment(left_expr, right_expr) {
      val resolved_left_expr = resolve_expr(left_expr, variable_map)?
      val resolved_right_expr = resolve_expr(right_expr, variable_map)?

      return Result::Success(Expression::Assignment(resolved_left_expr, resolved_right_expr))
    }
    when Expression::Conditional(condition_expr, then_expr, else_expr) {
      val resolved_condition_expr = resolve_expr(condition_expr, variable_map)?
      val resolved_then_expr = resolve_expr(then_expr, variable_map)?
      val resolved_else_expr = resolve_expr(else_expr, variable_map)?

      return Result::Success(Expression::Conditional(resolved_condition_expr, resolved_then_expr, resolved_else_expr))
    }
    when Expression::FunctionCall(name, arg_list) {
      if name not in variable_map {
        return Result::Failure("Type Checker Error: Function '$name' has not been declared in the current scope.")
      }

      val resolved_fn_name = variable_map[name]:unique_name
      
      val resolved_arg_list = []Expression
      for arg in arg_list {
        resolved_arg_list:push(resolve_expr(arg, variable_map)?)
      }

      return Result::Success(Expression::FunctionCall(resolved_fn_name, resolved_arg_list))
    }
  }
}

fn resolve_block_scope(block []AST, variable_map map[string, Entity]) Result[[]AST, string] {
  val new_variable_map = copy_variable_map(variable_map)
  return resolve_block(block, new_variable_map)
}

fn resolve_when(when_case When, variable_map map[string, Entity]) Result[When, string] {
  val resolved_condition_list = []Expression
  for condition in when_case:cond_list {
    resolved_condition_list:push(resolve_expr(condition, variable_map)?)
  }

  val resolved_block = resolve_block_scope(when_case:block, variable_map)?

  return Result::Success(
    When {
      cond_list: resolved_condition_list,
      block: resolved_block
    }
  )
}

fn resolve_stmt(stmt Statement, variable_map map[string, Entity]) Result[Statement, string] {
  match stmt {
   when Statement::Return(expr) {
    val resolved_expr = resolve_expr(expr, variable_map)?

    return Result::Success(Statement::Return(resolved_expr))
   }  
   when Statement::If(condition, then_branch, else_branch_opt) {
    val resolved_condition = resolve_expr(condition, variable_map)?
    val resolved_then_branch = resolve_stmt(then_branch, variable_map)?
    val resolved_else_branch_opt = match else_branch_opt {
      when Option::Some(stmt) => Option::Some(resolve_stmt(stmt, variable_map)?)
      when Option::None => Option::None
    }

    return Result::Success(Statement::If(resolved_condition, resolved_then_branch, resolved_else_branch_opt))
   }
   when Statement::Match(condition, when_case_list, else_block_opt) {
    val resolved_condition = resolve_expr(condition, variable_map)?
    val resolved_when_case_list = []When

    for when_case in when_case_list {
      resolved_when_case_list:push(resolve_when(when_case, variable_map)?)
    }

    val resolved_else_block_opt = match else_block_opt {
      when Option::Some(else_block) => Option::Some(resolve_block_scope(else_block, variable_map)?)
      when Option::None => Option::None
    } 

    return Result::Success(
      Statement::Match(
        resolved_condition,
        resolved_when_case_list,
        resolved_else_block_opt
      )
    )
   }
   when Statement::Compound(block) {
    val new_variable_map = copy_variable_map(variable_map)
    val resolved_block = resolve_block(block, new_variable_map)?

    return Result::Success(Statement::Compound(resolved_block))
   }
   when Statement::Expression(expr) {
    val resolved_expr = resolve_expr(expr, variable_map)?
    return Result::Success(Statement::Expression(resolved_expr))
   }
  }
}

fn resolve_var_or_val_decl(
  name string
  expr Expression 
  is_constant bool 
  variable_map map[string, Entity]
) Result[Declaration, string] {
  val resolved_expr = resolve_expr(expr, variable_map)?

  if name in variable_map {
    val prev_entry = variable_map[name]
    
    if prev_entry:is_from_current_block {
      val type_name = if is_constant then "Constant" else "Variable"
      return Result::Failure("Type Checker Error: $type_name '$name' has been already declared in the current scope.")
    }
  }

  val unique_name = generate_pseudonym(name)

  variable_map[name] = Entity {
    unique_name: unique_name
    is_from_current_block: true
  }

  return Result::Success(
    if is_constant 
      then Declaration::ConstantDeclaration(unique_name, resolved_expr) 
      else Declaration::VariableDeclaration(unique_name, resolved_expr)
  )
}

fn resolve_param(param Parameter, variable_map map[string, Entity]) Result[Parameter, string] {
  if param:name in variable_map and variable_map[param:name]:is_from_current_block {
    return Result::Failure("Type Checker Error: Parameter '$(param:name)' has been already declared in the current scope.")
  }

  val unique_name = generate_pseudonym(param:name)

  variable_map[param:name] = Entity {
    unique_name: unique_name
    is_from_current_block: true
  }

  return Result::Success(Parameter { name: unique_name, type: param:type }) 
}

fn resolve_decl(decl Declaration, variable_map map[string, Entity]) Result[Declaration, string] {
  match decl {
    when Declaration::FunctionDeclaration(name, param_list, ret_type, block) {
      if name not in variable_map {
        panic("Undeclared function '$name' should have been caught by Declaration Hoisting Pass.")
      }

      val inner_map = copy_variable_map(variable_map)
      val resolved_param_list = []Parameter

      for param in param_list {
        resolved_param_list:push(
          resolve_param(param, inner_map)?
        )
      }

      val resolved_block = resolve_block(block, inner_map)?

      return Result::Success(
        Declaration::FunctionDeclaration(name, resolved_param_list, ret_type, resolved_block)
      )
    }
    when Declaration::ConstantDeclaration(name, expr) {
      return resolve_var_or_val_decl(name, expr, true, variable_map)
    }
    when Declaration::VariableDeclaration(name, expr) {
      return resolve_var_or_val_decl(name, expr, false, variable_map)
    }
  }
}

fn hoist_decl_map(block_item_list []AST, variable_map map[string, Entity]) Result[map[string, Entity], string] {
  for block_item in block_item_list {
    if block_item is AST::Declaration(decl) and decl is Declaration::FunctionDeclaration(name, param_list, ret_type, node_list) {
      if name in variable_map and variable_map[name]:is_from_current_block {
        return Result::Failure("Type Checker Error: Function '$(name)' has been already declared in the current scope.")
      }
      
      variable_map[name] = Entity {
        unique_name: name
        is_from_current_block: true
      }
    }
  }

  return Result::Success(variable_map)
}

fn resolve_block_item(block_item AST, variable_map map[string, Entity]) Result[AST, string] {
  match block_item {
    when AST::Declaration(decl) {
      val resolved_decl = resolve_decl(decl, variable_map)?
      return Result::Success(AST::Declaration(resolved_decl))
    }
    when AST::Statement(stmt) {
      val resolved_stmt = resolve_stmt(stmt, variable_map)?
      return Result::Success(AST::Statement(resolved_stmt))
    }
  }
}

fn resolve_block(block []AST, variable_map map[string, Entity]) Result[[]AST, string] {
  val resolved_block = []AST
  val hoisted_map = hoist_decl_map(block, variable_map)?

  for block_item in block {
    val resolved_block_item = resolve_block_item(block_item, hoisted_map)?
    resolved_block:push(resolved_block_item)
  }

  return Result::Success(resolved_block)
}

pub fn resolve_program(program Program) Result[Program, string] {
  val resolved_content = resolve_block(program:content, map[string, Entity] {})?
  return Result::Success(
    Program { content: resolved_content }
  )
}
