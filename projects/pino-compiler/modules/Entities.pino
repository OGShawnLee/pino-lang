module Entities

from Utility import demangle_name

pub enum Literal {
  Bool
  Float
  Int
} 

pub union TokenType {
  Keyword
  Identifier
  Marker
  Literal(Literal)
  Illegal
  UnaryOperator
  BinaryOperator
  EOF
}

pub struct Token {
  type TokenType
  value string

  fn print {
    val type_str = match type {
      when TokenType::Keyword => "Keyword"
      when TokenType::Identifier => "Identifier"
      when TokenType::Marker => "Marker"
      when TokenType::Literal(literal) => str(literal)
      when TokenType::Illegal => "Illegal"
      when TokenType::UnaryOperator => "Unary Operator"
      when TokenType::BinaryOperator => "Binary Operator"
      when TokenType::EOF => "EOF"
    }

    println("Token { Type: $type_str, Value: $value }")
  }
}

pub struct TokenStream {
  list []Token
  cursor int

  fn peek(offset int) {
    if cursor + offset >= list:len {
      return Token { type: TokenType::EOF, value: "" }
    }

    return list[cursor + offset]
  }

  fn next {
    cursor += 1
  }

  fn consume {
    val curr = this:peek(0)
    this:next()
    return curr
  }

  fn expect_type(type TokenType) Result[Token, string] {
    val curr = this:peek(0)

    if curr:type == type {
      this:next()
      return Result::Success(curr)
    }

    return Result::Failure("Expected type $type, but got $(curr:type).")
  }

  fn expect_content(content string) Result[Token, string] {
    val curr = this:peek(0)

    if curr:value == content {
      this:next()
      return Result::Success(curr)
    }

    return Result::Failure("Expected '$content', but got '$(curr:value)'.")
  }

  fn print {
    for token in list {
      token:print()
    }
  }
}

pub enum UnaryOperator {
  Negate
  Not
}

pub enum BinaryOperator {
  Add
  Subtract
  Multiply
  Divide
  Remainder
  And
  Or
  Equal
  NotEqual
  LessThan
  LessOrEqual
  GreaterThan
  GreaterOrEqual
  Assign
  Conditional
  StaticMemberAccess
}

pub union Constant {
  Bool(bool)
  Float(float)
  Int(int)
}

pub union Expression {
  Constant(Constant)
  Var(string)
  Unary(UnaryOperator, Expression)
  Binary(BinaryOperator, Expression, Expression)
  Assignment(Expression, Expression)
  Conditional(Expression, Expression, Expression)
  FunctionCall(string, []Expression)
  List([]Expression, Type)
}

pub struct When {
  cond_list []Expression
  block []AST
}

pub union Loop {
  Infinite([]AST)
  While(Expression, []AST)
  ForIn(Expression, Expression, []AST)
}

pub union Statement {
  Return(Expression)
  If(Expression, Statement, Option[Statement])
  Compound([]AST)
  Match(Expression, []When, Option[[]AST])
  Expression(Expression)
  Loop(Loop)
  Break
  Continue
}

pub enum Primitive {
  Float
  Int
  Bool
}

pub union Type {
  Primitive(Primitive)
  Function([]Parameter, Type)
  Enum(string, []string)
  List(Type)
  Pending(string)
  Void
  Implicit
  Invalid
}

pub struct Parameter {
  name string
  type Type
}

pub union Declaration {
  FunctionDeclaration(string, []Parameter, Type, []AST)
  ConstantDeclaration(string, Expression, Type)
  VariableDeclaration(string, Expression, Type)
  EnumDeclaration(string, []string)
}

pub union AST {
  Statement(Statement)
  Declaration(Declaration)
}

pub struct Program {
  content []AST

  fn print {
    println("Program")
    Program::print_block(content)
  }

  static fn print_block(block []AST) {
    for node in block {
      Program::print_block_item(node)
    }
  }

  static fn print_block_item(node AST) {
    match node {
      when AST::Declaration(decl) {
        Program::print_decl(decl)
      }
      when AST::Statement(stmt) {
        Program::print_stmt(stmt)
      }
    }
  }

  static fn print_decl(decl Declaration) {
    match decl {
      when Declaration::FunctionDeclaration(name, param_list, ret_type, block) {
        println("Function: $name")

        if param_list:len > 0 {
          println("Parameters: ")
          for param in param_list {
            println("Name: $(param:name)")
            println("Type: $(Program::get_type_name(param:type))")
          }
        }

        println("Return Type: $(Program::get_type_name(ret_type))")
        Program::print_block(block)
      }
      when Declaration::VariableDeclaration(name, expr, type) {
        println("Variable: $name")
        println("Type: $(Program::get_type_name(type))")
        Program::print_expr(expr)
      }
      when Declaration::ConstantDeclaration(name, expr, type) {
        println("Constant Variable: $name")
        println("Type: $(Program::get_type_name(type))")
        Program::print_expr(expr)
      }
      when Declaration::EnumDeclaration(name, enum_constants) {
        println("Enum: $name")
        println("Constants: ")
        for enum_constant in enum_constants {
          println("- $enum_constant")
        }
      }
    }
  }

  static fn get_type_name(type Type) string {
    return match type {
      when Type::Primitive(primitive) => match primitive {
        when Primitive::Int => "int"
        when Primitive::Float => "float"
        when Primitive::Bool => "bool"
        else => "Invalid Primitive"
      }
      when Type::Function(param_list, ret_type) => "Function ($(Program::get_type_name(ret_type)))"
      when Type::Enum(name, constant_list) => demangle_name(name)
      when Type::List(inner_type) => "[]$(Program::get_type_name(inner_type))"
      when Type::Pending(name) => demangle_name(name)
      when Type::Implicit => "implicit"
      when Type::Void => "void"
      when Type::Invalid => "invalid"
    }
  }

  static fn print_stmt(stmt Statement) {
    match stmt {
      when Statement::Return(expr) {
        println("Return:")
        Program::print_expr(expr)
      }
      when Statement::If(condition, then_branch, else_branch_opt) {
        println("If:")
        Program::print_expr(condition)
        println("Then:")
        Program::print_stmt(then_branch)

        if else_branch_opt is Option::Some(else_branch) {
          println("Else:")
          Program::print_stmt(else_branch)
        }
      }
      when Statement::Match(expr, when_case_list, else_branch_opt) {
        println("Match:")
        for when_case in when_case_list {
          println("When")
          for condition in when_case:cond_list {
            Program::print_expr(condition)
          }
          Program::print_block(when_case:block)
        }
        if else_branch_opt is Option::Some(else_block) {
          println("Else:")
          Program::print_block(else_block)
        }
      }
      when Statement::Compound(block) {
        Program::print_block(block)
      }
      when Statement::Expression(expr) {
        Program::print_expr(expr)
      }
      when Statement::Loop(loop_variant) {
        match loop_variant {
          when Loop::Infinite(block) {
            println("Infinite Loop:")
            Program::print_block(block)
          }
          when Loop::While(condition, block) {
            println("While Loop:")
            Program::print_expr(condition)
            Program::print_block(block)
          }
          when Loop::ForIn(iterator_expr, iterable_expr, block) {
            println("For In Loop:")
            println("Var: $iterator_expr")
            Program::print_expr(iterable_expr)
            Program::print_block(block)
          }
        }
      }
      when Statement::Break {
        println("Break")
      }
      when Statement::Continue {
        println("Continue")
      }
    }
  }

  static fn print_expr(expr Expression) {
    match expr {
      when Expression::Constant(lit) {
        println("Constant: $lit")
      }
      when Expression::Var(name) {
        println("Var: $name")
      }
      when Expression::Conditional(condition, then_branch, else_branch) {
        println("Conditional:")
        println("If:")
        Program::print_expr(condition)
        println("Then:")
        Program::print_expr(then_branch)
        println("Else:")
        Program::print_expr(else_branch)
      }
      when Expression::Unary(un_op, expr) {
        println("Unary: $un_op")
        Program::print_expr(expr)
      }
      when Expression::Binary(bin_op, left, right) {
        println("Binary: $bin_op")
        Program::print_expr(left)
        Program::print_expr(right)
      }
      when Expression::Assignment(left, right) {
        println("Assignment")
        Program::print_expr(left)
        Program::print_expr(right)
      }
      when Expression::FunctionCall(name, args) {
        println("Function Call: $name")
        for arg in args {
          Program::print_expr(arg)
        }
      }
      when Expression::List(expr_list, list_type) {
        val type_str = Program::get_type_name(list_type)

        if expr_list:len == 0 {
          println("List ($(type_str)): []")
        } else {
          println("List ($(type_str)): [")
          for expr in expr_list {
            Program::print_expr(expr)
          }
          println("]")
        }
      }
    }
  }
}
