import Lexer
import Parser
import Checker
# import Transformer

fn main {
  val content = "val a = 12 val b = 10 val c = a * b"
  val begin = time()
  val list = Lexer::lex(content)
  val program = Parser::parse(list)
  val end = time()

  match program {
    when Result::Success(program) {
      program:print()

      val checker_result = Checker::resolve_program(program)

      match checker_result {
        when Result::Success(resolved_program) {
          println("Resolved AST")
          resolved_program:print()
        }
        when Result::Failure(error) {
          println("Unable to Resolve: $error")
        }
      }

      # val intermediate_representation = Transformer::transform_program(program)
      # Transformer::print_tacky(intermediate_representation)
    }
    when Result::Failure(error) {
      println("Unable to Parse: $error")
    }
  }

  println("Processed in $(end - begin) ms")
}