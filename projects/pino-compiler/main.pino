from Entities import Program
import Lexer
import Parser
import Checker

struct CompilerOutput {
  program Program
  is_valid bool
  error_list []string
  processing_time float
}

fn parse_file() Result[CompilerOutput, string] {
  val content = read_file("main.pino") or {
    return Result::Failure("Unable to read main.pino")
  }
  val begin = time()
  val list = Lexer::lex(content)
  val program = Parser::parse(list)?
  val resolved_program = Checker::resolve_program(program)?
  val error_list = Checker::type_check_program(resolved_program)
  val end = time()

  return Result::Success(
    CompilerOutput {
      program: resolved_program,
      is_valid: error_list:len == 0,
      error_list: error_list
      processing_time: end - begin
    }
  )
}

fn main {
  match parse_file(){
    when Result::Success(res) {
      if res:is_valid {
        println("Program main.pino Processed Successfully in $(res:processing_time) ms")
      } else {
        println("Program main.pino Processed with Errors in $(res:processing_time) ms")
        for error in res:error_list {
          println(error)
        }
      }
    }
    when Result::Failure(error) {
      println("Program main.pino Processed with Critical Errors.")
      println("Error: $error")
    }
  }
}