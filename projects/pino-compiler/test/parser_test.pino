from Entities import 
  Program,
  AST,
  Declaration,
  Parameter,
  When,
  Statement,
  Expression,
  BinaryOperator,
  UnaryOperator,
  Token,
  TokenStream
from Lexer import lex
from Parser import parse_line, parse_block, parse_decl, parse_fn_decl, parse_stmt, parse_expr

test "AST: Should parse a Program with multiple top-level declarations and expressions" {
  val program = parse_line("val a = 12 var b = 20 b = b + 10 fn add int { val double_n = a * 2 return double_n + b }")
  assert program == Result::Success(
    Program {
      content: [
        AST::Declaration(Declaration::ConstantDeclaration("a", Expression::Constant(12))),
        AST::Declaration(Declaration::VariableDeclaration("b", Expression::Constant(20))),
        AST::Statement(Statement::Expression(Expression::Assignment(
          Expression::Var("b"),
          Expression::Binary(BinaryOperator::Add, Expression::Var("b"), Expression::Constant(10))
        ))),
        AST::Declaration(Declaration::FunctionDeclaration(
          "add",
          []Parameter,
          Option::Some("int"),
          [
            AST::Declaration(
              Declaration::ConstantDeclaration(
                "double_n",
                Expression::Binary(
                  BinaryOperator::Multiply,
                  Expression::Var("a"),
                  Expression::Constant(2)
                )
              )
            ),
            AST::Statement(
              Statement::Return(
                Expression::Binary(
                  BinaryOperator::Add,
                  Expression::Var("double_n"),
                  Expression::Var("b")
                )
              )
            )
          ]
        ))
      ]
    }
  )
}

test "AST: Should parse a block of multiple declarations and expressions" {
  val content = "{ val a = 10 var b = 20 b = b + 10 val c = a - b }"
  val list = lex(content)
  val stream = TokenStream { list: list, cursor: 0 }
  val block = parse_block(stream, true)
  assert block == Result::Success([
    AST::Declaration(Declaration::ConstantDeclaration("a", Expression::Constant(10))),
    AST::Declaration(Declaration::VariableDeclaration("b", Expression::Constant(20))),
    AST::Statement(
      Statement::Expression(
        Expression::Assignment(
          Expression::Var("b"),
          Expression::Binary(BinaryOperator::Add, Expression::Var("b"), Expression::Constant(10))
        )
      )
    ),
    AST::Declaration(Declaration::ConstantDeclaration(
      "c", 
      Expression::Binary(
        BinaryOperator::Subtract,
        Expression::Var("a"),
        Expression::Var("b")
      )
    ))
  ])
}

test "Declaration: Should parse a var declaration" {
  val program = parse_decl(TokenStream { list: lex("var n = 2"), cursor: 0 })
  assert program == Result::Success(
    Declaration::VariableDeclaration("n", Expression::Constant(2))
  )
}

test "Declaration: Should parse a val declaration" {
  val program = parse_decl(TokenStream { list: lex("val n = 2"), cursor: 0 })
  assert program == Result::Success(
    Declaration::ConstantDeclaration("n", Expression::Constant(2))
  )
}

test "Declaration: Should parse a fn declaration (no parameter, implicit return type)" {
  val function = parse_decl(
    TokenStream { 
      list: lex("fn main { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main", 
      []Parameter, 
      Option::None, 
      [AST::Statement(Statement::Return(Expression::Constant(2)))]
    )
  )
}

test "Declaration: Should parse a fn declaration (no parameter (with parenthesis), implicit return type)" {
  val function = parse_decl(
    TokenStream { 
      list: lex("fn main() { return 2 }" ), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main", 
      []Parameter, 
      Option::None, 
      [AST::Statement(Statement::Return(Expression::Constant(2)))]
    )
  )
}

test "Declaration: Should parse a fn declaration (no parameter, explicit return type)" {
  val function = parse_decl(
    TokenStream { 
      list: lex("fn main int { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main", 
      []Parameter, 
      Option::Some("int"), 
      [AST::Statement(Statement::Return(Expression::Constant(2)))]
    )
  )
}

test "Declaration: Should parse a fn declaration (no parameter (with parenthesis), explicit return type)" {
  val function = parse_decl(
    TokenStream { 
      list: lex("fn main() int { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main", 
      []Parameter, 
      Option::Some("int"), 
      [AST::Statement(Statement::Return(Expression::Constant(2)))]
    )
  )
}

test "Declaration: Should parse a fn declaration (one parameter, implicit return type)" {
  val function = parse_decl(
    TokenStream { 
      list: lex("fn main(a int) { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main", 
      [Parameter { name: "a", type: "int" }], 
      Option::None, 
      [AST::Statement(Statement::Return(Expression::Constant(2)))]
    )
  )
}

test "Declaration: Should parse a fn declaration (one parameter, explicit return type)" {
  val function = parse_decl(
    TokenStream { 
      list: lex("fn main(a int) int { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main", 
      [Parameter { name: "a", type: "int" }], 
      Option::Some("int"), 
      [AST::Statement(Statement::Return(Expression::Constant(2)))]
    )
  )
}

test "Declaration: Should parse a fn declaration (multiple parameter (commas), implicit return type)" {
  val function = parse_decl(
    TokenStream { 
      list: lex("fn main(a int, b int, c int) { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main", 
      [
        Parameter { name: "a", type: "int" } 
        Parameter { name: "b", type: "int" }
        Parameter { name: "c", type: "int" }
      ], 
      Option::None, 
      [AST::Statement(Statement::Return(Expression::Constant(2)))]
    )
  )
}

test "Declaration: Should parse a fn declaration (multiple parameter (no commas), implicit return type)" {
  val function = parse_decl(
    TokenStream { 
      list: lex("fn main(a int b int c int) { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main", 
      [
        Parameter { name: "a", type: "int" } 
        Parameter { name: "b", type: "int" }
        Parameter { name: "c", type: "int" }
      ], 
      Option::None, 
      [AST::Statement(Statement::Return(Expression::Constant(2)))]
    )
  )
}

