test "Declaration: Should parse an enum declaration (one constant)" {
  val enum_declaration = parse_decl(TokenStream { list: lex("enum Color { Red }"), cursor: 0 })
  assert enum_declaration == Result::Success(
    Declaration::EnumDeclaration("Color", ["Red"])
  )
}

test "Declaration: Should parse an enum declaration (multiple constants (commas))" {
  val enum_declaration = parse_decl(TokenStream { list: lex("enum Color { Red, Green, Blue }"), cursor: 0 })
  assert enum_declaration == Result::Success(
    Declaration::EnumDeclaration("Color", ["Red", "Green", "Blue"])
  )
}

test "Declaration: Should parse an enum declaration (multiple constants (no commas))" {
  val enum_declaration = parse_decl(TokenStream { list: lex("enum Color { Red Green Blue }"), cursor: 0 })
  assert enum_declaration == Result::Success(
    Declaration::EnumDeclaration("Color", ["Red", "Green", "Blue"])
  )
}

test "Declaration: Should catch an enum declaration (no name)" {
  val enum_declaration = parse_decl(TokenStream { list: lex("enum { Red Green Blue }"), cursor: 0 })
  assert enum_declaration == Result::Failure("Expected enum name, instead got '{'. Tip: Add an enum name before '{'.")
}


test "Declaration: Should catch an enum declaration (no capitalized name)" {
  val enum_declaration = parse_decl(TokenStream { list: lex("enum color { Red Green Blue }"), cursor: 0 })
  assert enum_declaration == Result::Failure("Expected capitalized name for enum 'color'. Tip: Capitalize enum names.")
}

test "Declaration: Should catch an enum declaration (no capitalized constant name)" {
  val enum_declaration = parse_decl(TokenStream { list: lex("enum Color { red Green Blue }"), cursor: 0 })
  assert enum_declaration == Result::Failure("Expected capitalized constant in enum 'Color'. Got 'red'. Tip: Capitalize enum constants.")
}

test "Declaration: Should catch an enum declaration (no opening brace)" {
  val enum_declaration = parse_decl(TokenStream { list: lex("enum Color Red Green Blue }"), cursor: 0 })
  assert enum_declaration == Result::Failure("Expected '{' after enum name 'Color', instead got 'Red'. Tip: Add '{' after enum name 'Color'.")
}

test "Declaration: Should catch an enum declaration (no closing brace)" {
  val enum_declaration = parse_decl(TokenStream { list: lex("enum Color { Red Green Blue"), cursor: 0 })
  assert enum_declaration == Result::Failure("Expected '}' after enum 'Color' constants. Got 'EOF'. Tip: Add '}' after the last enum constant in 'Color'.")
}

test "Statement: Should parse an if statement (no else)" {
  val if_stmt = parse_stmt(TokenStream { list: lex("if 1 > 2 { return 2 }"), cursor: 0 }) 
  assert if_stmt == Result::Success(
    Statement::If(
      Expression::Binary(
        BinaryOperator::GreaterThan,
        Expression::Constant(1),
        Expression::Constant(2)
      ),
      Statement::Compound([
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]),
      Option::None
    )
  )
}

test "Statement: Should parse an if statement (else)" {
  val if_stmt = parse_stmt(TokenStream { list: lex("if 1 > 2 { return 2 } else { return 3 }"), cursor: 0 }) 
  assert if_stmt == Result::Success(
    Statement::If(
      Expression::Binary(
        BinaryOperator::GreaterThan,
        Expression::Constant(1),
        Expression::Constant(2)
      ),
      Statement::Compound([
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]),
      Option::Some(
        Statement::Compound([
          AST::Statement(Statement::Return(Expression::Constant(3)))
        ])
      )
    )
  )
}

test "Statement: Should parse an if statement (else-if)" {
  val if_stmt = parse_stmt(TokenStream { list: lex("if 1 > 2 { return 2 } else if 1 < 3 { return 3 }"), cursor: 0 }) 
  assert if_stmt == Result::Success(
    Statement::If(
      Expression::Binary(
        BinaryOperator::GreaterThan,
        Expression::Constant(1),
        Expression::Constant(2)
      ),
      Statement::Compound([
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]),
      Option::Some(
        Statement::If(
          Expression::Binary(
            BinaryOperator::LessThan,
            Expression::Constant(1),
            Expression::Constant(3)
          ),
          Statement::Compound([
            AST::Statement(Statement::Return(Expression::Constant(3)))
          ]),
          Option::None
        )
      )
    )
  )
}

test "Statement: Should parse an if statement (else-if-else)" {
  val if_stmt = parse_stmt(TokenStream { list: lex("if 1 > 2 { return 2 } else if 1 < 3 { return 3 } else { return 4 }"), cursor: 0 }) 
  assert if_stmt == Result::Success(
    Statement::If(
      Expression::Binary(
        BinaryOperator::GreaterThan,
        Expression::Constant(1),
        Expression::Constant(2)
      ),
      Statement::Compound([
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]),
      Option::Some(
        Statement::If(
          Expression::Binary(
            BinaryOperator::LessThan,
            Expression::Constant(1),
            Expression::Constant(3)
          ),
          Statement::Compound([
            AST::Statement(Statement::Return(Expression::Constant(3)))
          ]),
          Option::Some(
            Statement::Compound([
              AST::Statement(Statement::Return(Expression::Constant(4)))
            ])
          )
        )
      )
    )
  )
}

test "Statement: Should parse a match statement (no case, no else)" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 {}"), cursor: 0 })
  assert match_stmt == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      []When,
      Option::None
    )
  )
}

test "Statement: Should parse a match statement (one case)" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { when 1 { return 2 } }"), cursor: 0 })
  assert match_stmt == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      [
        When { 
          cond_list: [Expression::Constant(1)]
          block: [
            AST::Statement(Statement::Return(Expression::Constant(2)))
          ] 
        }
      ],
      Option::None
    )
  )
}

test "Statement: Should parse a match statement (one case with multiple conditions (commas))" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { when 1, 2, 3 { return 2 } }"), cursor: 0 })
  assert match_stmt == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      [
        When { 
          cond_list: [Expression::Constant(1), Expression::Constant(2), Expression::Constant(3)]
          block: [
            AST::Statement(Statement::Return(Expression::Constant(2)))
          ] 
        }
      ],
      Option::None
    )
  )
}

test "Statement: Should parse a match statement (one case with multiple conditions (no commas))" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { when 1 2 3 { return 2 } }"), cursor: 0 })
  assert match_stmt == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      [
        When { 
          cond_list: [Expression::Constant(1), Expression::Constant(2), Expression::Constant(3)]
          block: [
            AST::Statement(Statement::Return(Expression::Constant(2)))
          ] 
        }
      ],
      Option::None
    )
  )
}

test "Statement: Should parse a match statement (one case, one else)" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { when 1 { return 2 } else { return 3 } }"), cursor: 0 })
  assert match_stmt == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      [
        When { 
          cond_list: [Expression::Constant(1)]
          block: [
            AST::Statement(Statement::Return(Expression::Constant(2)))
          ] 
        }
      ],
      Option::Some([
        AST::Statement(Statement::Return(Expression::Constant(3)))
      ])
    )
  )
}

test "Statement: Should parse a match statement (multiple case)" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { when 1 { return 2 } when 2 { return 3 } }"), cursor: 0 })
  assert match_stmt == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      [
        When { 
          cond_list: [Expression::Constant(1)]
          block: [
            AST::Statement(Statement::Return(Expression::Constant(2)))
          ] 
        }
        When { 
          cond_list: [Expression::Constant(2)]
          block: [
            AST::Statement(Statement::Return(Expression::Constant(3)))
          ] 
        }
      ],
      Option::None
    )
  )
}

test "Statement: Should parse a match statement (multiple case, one else)" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { when 1 { return 2 } when 2 { return 3 } else { return 4 } }"), cursor: 0 })
  assert match_stmt == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      [
        When { 
          cond_list: [Expression::Constant(1)]
          block: [
            AST::Statement(Statement::Return(Expression::Constant(2)))
          ] 
        }
        When { 
          cond_list: [Expression::Constant(2)]
          block: [
            AST::Statement(Statement::Return(Expression::Constant(3)))
          ] 
        }
      ],
      Option::Some([
        AST::Statement(Statement::Return(Expression::Constant(4)))
      ])
    )
  )
}

test "Statement: Should catch match statement (no case, multiple else)" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { else { return 3 } else { return 4 } }"), cursor: 0 })
  assert match_stmt == Result::Failure("Expected at most one else branch in match statement.")
}

test "Statement: Should catch match statement (one case, multiple else)" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { when 1 { return 3 } else { return 4 } else { return 5 } }"), cursor: 0 })
  assert match_stmt == Result::Failure("Expected at most one else branch in match statement.")
}

test "Statement: Should catch match statement (multiple case, multiple else)" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { when 1 { return 3 } when 2 { return 4 } else { return 5 } else { return 6 } }"), cursor: 0 })
  assert match_stmt == Result::Failure("Expected at most one else branch in match statement.")
}


test "Statement: Should catch match statement (no when or else statement inside block (expression))" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { 1 }"), cursor: 0 })
  assert match_stmt == Result::Failure("Expected only multiple when branches or one else branch inside a match statement. Instead got '1'.")
}

test "Statement: Should catch match statement (no when or else statement inside block (var declaration))" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { var n = 1 }"), cursor: 0 })
  assert match_stmt == Result::Failure("Expected only multiple when branches or one else branch inside a match statement. Instead got 'var'.")
}

test "Statement: Should catch match statement (no when or else statement inside block (val declaration))" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { val n = 1 }"), cursor: 0 })
  assert match_stmt == Result::Failure("Expected only multiple when branches or one else branch inside a match statement. Instead got 'val'.")
}


test "Statement: Should catch match statement (no when or else statement inside block (function declaration))" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { fn main {} }"), cursor: 0 })
  assert match_stmt == Result::Failure("Expected only multiple when branches or one else branch inside a match statement. Instead got 'fn'.")
}

test "Statement: Should catch match statement (no when or else statement inside block (if statement))" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { if 1 > 2 { return 2 } }"), cursor: 0 })
  assert match_stmt == Result::Failure("Expected only multiple when branches or one else branch inside a match statement. Instead got 'if'.")
}

test "Statement: Should catch match statement (no when or else statement inside block (match statement))" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { match 1 { } }"), cursor: 0 })
  assert match_stmt == Result::Failure("Expected only multiple when branches or one else branch inside a match statement. Instead got 'match'.")
}

test "Statement: Should catch match statement (no when or else statement inside block (return statement))" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { return 2 }"), cursor: 0 })
  assert match_stmt == Result::Failure("Expected only multiple when branches or one else branch inside a match statement. Instead got 'return'.")
}

test "Statement: Should catch match statement (no condition in when branch)" {
  val match_stmt = parse_stmt(TokenStream { list: lex("match 1 { when { 1 } }"), cursor: 0 })
  assert match_stmt == Result::Failure("Expected at least one condition in when branch.")
}

test "Expression: Should parse a constant expression" {
  val expr = parse_expr(TokenStream { list: lex("1"), cursor: 0 }, 0)
  assert expr == Result::Success(
    Expression::Constant(1)
  )
}

test "Expression: Should parse an unary expression (negate)" {
  val expr = parse_expr(TokenStream { list: lex("-1"), cursor: 0 }, 0)
  assert expr == Result::Success(
    Expression::Unary(
      UnaryOperator::Negate,
      Expression::Constant(1)
    )
  )
}

test "Expression: Should parse an unary expression (not)" {
  val expr = parse_expr(TokenStream { list: lex("not 1"), cursor: 0 }, 0)
  assert expr == Result::Success(
    Expression::Unary(
      UnaryOperator::Not,
      Expression::Constant(1)
    )
  )
}

test "Expression: Should parse a parse a higher precedence binary expression" {
  val input_expr = "12 + 2 * 2"
  val expr = parse_expr(TokenStream { list: lex(input_expr), cursor: 0 }, 0)
  assert expr == Result::Success(
    Expression::Binary(
      BinaryOperator::Add,
      Expression::Constant(12),
      Expression::Binary(
        BinaryOperator::Multiply,
        Expression::Constant(2),
        Expression::Constant(2)
      )
    )
  )
}

test "Expression: Should parse a parse a parenthesized expression" {
  val input_expr = "(12 + 2)"
  val expr = parse_expr(TokenStream { list: lex(input_expr), cursor: 0 }, 0)
  assert expr == Result::Success(
    Expression::Binary(
      BinaryOperator::Add,
      Expression::Constant(12),
      Expression::Constant(2)
    )
  )
}

test "Expression: Should parse a parse a higher precedence parenthesized expression" {
  val input_expr = "(12 + 2) * 2"
  val expr = parse_expr(TokenStream { list: lex(input_expr), cursor: 0 }, 0)
  assert expr == Result::Success(
    Expression::Binary(
      BinaryOperator::Multiply,
      Expression::Binary(
        BinaryOperator::Add,
        Expression::Constant(12),
        Expression::Constant(2)
      ),
      Expression::Constant(2)
    )
  )
}

test "Expression: Should parse a conditional expression" {
  val input_expr = "if 1 > 0 then 1 else 0"
  val expr = parse_expr(TokenStream { list: lex(input_expr), cursor: 0 }, 0)
  assert expr == Result::Success(
    Expression::Conditional(
      Expression::Binary(
        BinaryOperator::GreaterThan,
        Expression::Constant(1),
        Expression::Constant(0)
      ),
      Expression::Constant(1),
      Expression::Constant(0)
    )
  )
}