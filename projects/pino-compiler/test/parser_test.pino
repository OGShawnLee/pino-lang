from Entities import AST, Declaration, Expression, TokenStream, Statement, Program, BinaryOperator, UnaryOperator, Type, Parameter
from Lexer import lex
from Parser import parse_line, parse_ast, parse_fn_decl, parse_stmt, parse_expr

test "AST: Should parse a Program with multiple top-level declarations and expressions" {
  val program = parse_line("val a = 12 var b = 20 b = b + 10 fn add int { val double_n = a * 2 return double_n + b }")
  assert program == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::ConstantDeclaration("a", Expression::Constant(12))),
        AST::Declaration(Declaration::VariableDeclaration("b", Expression::Constant(20))),
        AST::Expression(Expression::Assignment(
          Expression::Var("b"),
          Expression::Binary(BinaryOperator::Add, Expression::Var("b"), Expression::Constant(10))
        )),
        AST::Declaration(Declaration::FunctionDeclaration("add", []Parameter, Type::Explicit("int"), [
          AST::Declaration(Declaration::ConstantDeclaration(
            "double_n",
            Expression::Binary(
              BinaryOperator::Multiply,
              Expression::Var("a"),
              Expression::Constant(2)
            )
          )),
          AST::Statement(Statement::Return(
            Expression::Binary(
              BinaryOperator::Add,
              Expression::Var("double_n"),
              Expression::Var("b")
            )
          ))
        ]))
      ]
    }
  )
}

test "AST: Should parse a block of multiple declarations and expressions" {
  val content = "{ val a = 10 var b = 20 b = b + 10 val c = a - b }"
  val list = lex(content)
  val stream = TokenStream { list: list, cursor: 0 }
  val block = parse_ast(stream, true)
  assert block == Result::Success([
    AST::Declaration(Declaration::ConstantDeclaration("a", Expression::Constant(10))),
    AST::Declaration(Declaration::VariableDeclaration("b", Expression::Constant(20))),
    AST::Expression(Expression::Assignment(
      Expression::Var("b"),
      Expression::Binary(BinaryOperator::Add, Expression::Var("b"), Expression::Constant(10))
    )),
    AST::Declaration(Declaration::ConstantDeclaration(
      "c", 
      Expression::Binary(
        BinaryOperator::Subtract,
        Expression::Var("a"),
        Expression::Var("b")
      )
    ))
  ])
}

test "Declaration: Should parse a var declaration" {
  val program = parse_line("var n = 2")
  assert program == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::VariableDeclaration("n", Expression::Constant(2)))
      ]
    }
  )
}

test "Declaration: Should parse a val declaration" {
  val program = parse_line("val n = 2")
  assert program == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::ConstantDeclaration("n", Expression::Constant(2)))
      ]
    }
  )
}

test "Declaration: Should parse a fn declaration (no parameter-list, explicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main int { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      []Parameter,
      Type::Explicit("int"),
      [
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]
    )
  )
}

test "Declaration: Should parse a fn declaration (no parameter-list, implicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      []Parameter,
      Type::Implicit,
      [
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]
    )
  )
}

test "Declaration: Should parse a fn declaration (empty parameter-list, explicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main() int { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      []Parameter,
      Type::Explicit("int"),
      [
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]
    )
  )
}


test "Declaration: Should parse a fn declaration (empty parameter-list, implicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main() { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      []Parameter,
      Type::Implicit,
      [
        AST::Statement(Statement::Return(Expression::Constant(2)))
      ]
    )
  )
}

test "Declaration: Should parse a fn declaration (parameter-list, explicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main(a int, b int) int { return a + b }"), 
      cursor: 0 
    }
  )

  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      [
        Parameter { name: "a", type: "int" },
        Parameter { name: "b", type: "int" }
      ],
      Type::Explicit("int"),
      [
        AST::Statement(Statement::Return(
          Expression::Binary(BinaryOperator::Add, Expression::Var("a"), Expression::Var("b"))
        ))
      ]
    )
  )
}

test "Declaration: Should parse a fn declaration (parameter-list, implicit return-type)" {
  val function = parse_fn_decl(
    TokenStream { 
      list: lex("fn main(a int, b int) { return a + b }"), 
      cursor: 0 
    }
  )

  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main",
      [
        Parameter { name: "a", type: "int" },
        Parameter { name: "b", type: "int" }
      ],
      Type::Implicit,
      [
        AST::Statement(Statement::Return(
          Expression::Binary(BinaryOperator::Add, Expression::Var("a"), Expression::Var("b"))
        ))
      ]
    )
  )
}

test "Statement: Should parse an if statement without else branch" {
  val if_statement = parse_stmt(TokenStream { list: lex("if 12 > 2 { return 12 }"), cursor: 0 }) 
  assert if_statement == Result::Success(
    Statement::If(
      Expression::Binary(
        BinaryOperator::GreaterThan,
        Expression::Constant(12),
        Expression::Constant(2)
      ),
      Statement::Compound([
        AST::Statement(Statement::Return(Expression::Constant(12)))
      ]),
      Option::None
    )
  )
}

test "Statement: Should parse an if statement with else branch" {
  val if_statement = parse_stmt(TokenStream { list: lex("if 12 > 2 { return 12 } else { return 22 }"), cursor: 0 }) 
  assert if_statement == Result::Success(
    Statement::If(
      Expression::Binary(
        BinaryOperator::GreaterThan,
        Expression::Constant(12),
        Expression::Constant(2)
      ),
      Statement::Compound([
        AST::Statement(Statement::Return(Expression::Constant(12)))
      ]),
      Option::Some(Statement::Compound([
        AST::Statement(Statement::Return(Expression::Constant(22)))
      ]))
    )
  )
}

test "Statement: Should parse an if-else statement" {
  val if_statement = parse_stmt(TokenStream { list: lex("if 1 < 2 { 1 } else if 1 < 3 { 2 }"), cursor: 0 }) 
  assert if_statement == Result::Success(
    Statement::If(
      Expression::Binary(
        BinaryOperator::LessThan,
        Expression::Constant(1),
        Expression::Constant(2)
      ),
      Statement::Compound([
        AST::Expression(Expression::Constant(1))
      ]),
      Option::Some(
        Statement::If(
          Expression::Binary(
            BinaryOperator::LessThan,
            Expression::Constant(1),
            Expression::Constant(3)
          ),
          Statement::Compound([
            AST::Expression(Expression::Constant(2))
          ]),
          Option::None
        )
      )
    )
  )
}

test "Statement: Should parse an if-else-else statement" {
  val if_statement = parse_stmt(TokenStream { list: lex("if 1 < 2 { 1 } else if 1 < 3 { 2 } else { 3 }"), cursor: 0 }) 
  assert if_statement == Result::Success(
    Statement::If(
      Expression::Binary(
        BinaryOperator::LessThan,
        Expression::Constant(1),
        Expression::Constant(2)
      ),
      Statement::Compound([
        AST::Expression(Expression::Constant(1))
      ]),
      Option::Some(
        Statement::If(
          Expression::Binary(
            BinaryOperator::LessThan,
            Expression::Constant(1),
            Expression::Constant(3)
          ),
          Statement::Compound([
            AST::Expression(Expression::Constant(2))
          ]),
          Option::Some(
            Statement::Compound([
              AST::Expression(Expression::Constant(3))
            ])
          )
        )
      )
    )
  )
}

test "Statement: Should parse a match statement (empty)" {
  val match_statement = parse_stmt(TokenStream { list: lex("match 1 {}"), cursor: 0 })
  assert match_statement == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      Statement::Compound([]AST)
    )
  )
}

test "Statement: Should parse a match statement (one when case)" {
  val match_statement = parse_stmt(TokenStream { list: lex("match 1 { when 1 { 1 } }"), cursor: 0 })
  assert match_statement == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      Statement::Compound([
        AST::Statement(Statement::When(
          [Expression::Constant(1)],
          Statement::Compound([
            AST::Expression(Expression::Constant(1))
          ])
        ))
      ])
    )
  )
}

test "Statement: Should catch match statement (no when or else statement inside block)" {
  val match_statement = parse_stmt(TokenStream { list: lex("match 1 { 2 3 val n = 12 }"), cursor: 0 })
  assert match_statement == Result::Failure("Expected only multiple when statements or one else statement inside a match block.")
}

test "Statement: Should catch match statement (invalid statement)" {
  val match_statement = parse_stmt(TokenStream { list: lex("match 1 { return 2 }"), cursor: 0 })
  assert match_statement == Result::Failure("Expected only when or else statements inside a match block.")
}

test "Statement: Should parse a match statement (multiple when case)" {
  val match_statement = parse_stmt(TokenStream { list: lex("match 1 { when 1 { 1 } when 2 { 2 } when 3 { 3 } }"), cursor: 0 })
  assert match_statement == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      Statement::Compound([
        AST::Statement(Statement::When(
          [Expression::Constant(1)],
          Statement::Compound([
            AST::Expression(Expression::Constant(1))
          ])
        )),
        AST::Statement(Statement::When(
          [Expression::Constant(2)],
          Statement::Compound([
            AST::Expression(Expression::Constant(2))
          ])
        )),
        AST::Statement(Statement::When(
          [Expression::Constant(3)],
          Statement::Compound([
            AST::Expression(Expression::Constant(3))
          ])
        ))
      ])
    )
  )
}

test "Statement: Should parse a match statement (one when case with multiple conditions (commas))" {
  val match_statement = parse_stmt(TokenStream { list: lex("match 1 { when 1, 2, 3 { 1 } }"), cursor: 0 })
  assert match_statement == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      Statement::Compound([
        AST::Statement(Statement::When(
          [
            Expression::Constant(1),
            Expression::Constant(2),
            Expression::Constant(3)
          ],
          Statement::Compound([
            AST::Expression(Expression::Constant(1))
          ])
        ))
      ])
    )
  )
}

test "Statement: Should parse a match statement (one when case with multiple conditions (no-commas))" {
  val match_statement = parse_stmt(TokenStream { list: lex("match 1 { when 1 2 3 { 1 } }"), cursor: 0 })
  assert match_statement == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      Statement::Compound([
        AST::Statement(Statement::When(
          [
            Expression::Constant(1),
            Expression::Constant(2),
            Expression::Constant(3)
          ],
          Statement::Compound([
            AST::Expression(Expression::Constant(1))
          ])
        ))
      ])
    )
  )
}

test "Statement: Should parse a match statement (one when case with multiple conditions (no-commas))" {
  val match_statement = parse_stmt(TokenStream { list: lex("match 1 { when 1 2 3 { 1 } }"), cursor: 0 })
  assert match_statement == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      Statement::Compound([
        AST::Statement(Statement::When(
          [
            Expression::Constant(1),
            Expression::Constant(2),
            Expression::Constant(3)
          ],
          Statement::Compound([
            AST::Expression(Expression::Constant(1))
          ])
        ))
      ])
    )
  )
}

test "Statement: Should parse a match statement (one else case)" {
  val match_statement = parse_stmt(TokenStream { list: lex("match 1 { else { 1 } }"), cursor: 0 })
  assert match_statement == Result::Success(
    Statement::Match(
      Expression::Constant(1),
      Statement::Compound([
        AST::Statement(Statement::Else(
          Statement::Compound([
            AST::Expression(Expression::Constant(1))
          ])
        ))
      ])
    )
  )
}

test "Statement: Should catch match statement (more than one else case)" {
  val match_statement = parse_stmt(TokenStream { list: lex("match 1 { else { 1 } else { 2 }}"), cursor: 0 })
  assert match_statement == Result::Failure("Expected only one else statement in match block.")
}

test "Expression: Should parse a parse a binary expression" {
  val content = "12 + 2"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Binary(
      BinaryOperator::Add,
      Expression::Constant(12),
      Expression::Constant(2)
    )
  )
}

test "Expression: Should parse a parse a higher precedence binary expression" {
  val content = "12 + 2 * 2"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Binary(
      BinaryOperator::Add,
      Expression::Constant(12),
      Expression::Binary(
        BinaryOperator::Multiply,
        Expression::Constant(2),
        Expression::Constant(2)
      )
    )
  )
}

test "Expression: Should parse a parse a unary expression" {
  val content = "12 + -2"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Binary(
      BinaryOperator::Add,
      Expression::Constant(12),
      Expression::Unary(
        UnaryOperator::Negate,
        Expression::Constant(2)
      )
    )
  )
}

test "Expression: Should parse a parse a parenthesized expression" {
  val content = "(12 + 2)"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Binary(
      BinaryOperator::Add,
      Expression::Constant(12),
      Expression::Constant(2)
    )
  )
}

test "Expression: Should parse a parse a higher precedence parenthesized expression" {
  val content = "(12 + 2) * 2"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Binary(
      BinaryOperator::Multiply,
      Expression::Binary(
        BinaryOperator::Add,
        Expression::Constant(12),
        Expression::Constant(2)
      ),
      Expression::Constant(2)
    )
  )
}

test "Expression: Should parse a conditional expression" {
  val content = "if 12 > 0 then 2 else 1"
  val list = lex(content)
  val program = parse_expr(TokenStream { list: list, cursor: 0 }, 0)
  assert program == Result::Success(
    Expression::Conditional(
      Expression::Binary(
        BinaryOperator::GreaterThan,
        Expression::Constant(12),
        Expression::Constant(0)
      ),
      Expression::Constant(2),
      Expression::Constant(1)
    )
  )
}