        Parameter { name: "b", type: "int" }
        Parameter { name: "c", type: "int" }
      ], 
      Option::Some("int"), 
      [AST::Statement(Statement::Return(Expression::Constant(2)))]
    )
  )
}

test "Declaration: Should parse a fn declaration (multiple parameter (no commas), explicit return type)" {
  val function = parse_decl(
    TokenStream { 
      list: lex("fn main(a int b int c int) int { return 2 }"), 
      cursor: 0 
    }
  )
  assert function == Result::Success(
    Declaration::FunctionDeclaration(
      "main", 
