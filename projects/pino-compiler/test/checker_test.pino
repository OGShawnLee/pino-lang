test "Identifier Resolution: Should allow shadowing (val -> val) in if-else-if statement scopes" {
  val program = parse_line("val n = 1 if 1 < 2 { val n = 2 } else if 1 < 3 { val n = 3 } else { val n = 4 }") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Declaration(Declaration::ConstantDeclaration("_pino_n_0", Expression::Constant(1), Type::Implicit)),
        AST::Statement(Statement::If(
          Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(2)),
          Statement::Compound([
            AST::Declaration(Declaration::ConstantDeclaration("_pino_n_1", Expression::Constant(2), Type::Implicit))
          ]),
          Option::Some(Statement::If(
            Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(3)),
            Statement::Compound([
              AST::Declaration(Declaration::ConstantDeclaration("_pino_n_2", Expression::Constant(3), Type::Implicit))
            ]),
            Option::Some(Statement::Compound([
              AST::Declaration(Declaration::ConstantDeclaration("_pino_n_3", Expression::Constant(4), Type::Implicit))
            ]))
          ))
        ))
      ]
    }
  )
}

