test "Identifier Resolution: Should allow redeclaration of constant as constant in if-else-if statement scopes" {
  val program = parse_line("val n = 1 if 1 < 2 { val n = 2 } else if 1 < 3 { val n = 3 } else { val n = 4 }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::ConstantDeclaration("n_0", Expression::Constant(1))),
        AST::Statement(Statement::If(
          Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(2)),
          Statement::Compound([
            AST::Declaration(Declaration::ConstantDeclaration("n_1", Expression::Constant(2)))
          ]),
          Option::Some(Statement::If(
            Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(3)),
            Statement::Compound([
              AST::Declaration(Declaration::ConstantDeclaration("n_2", Expression::Constant(3)))
            ]),
            Option::Some(Statement::Compound([
              AST::Declaration(Declaration::ConstantDeclaration("n_3", Expression::Constant(4)))
            ]))
          ))
        ))
      ]
    }
  )
}

test "Identifier Resolution: Should allow redeclaration of constant as variable in if-else-if statement scopes" {
  val program = parse_line("val n = 1 if 1 < 2 { var n = 2 } else if 1 < 3 { var n = 3 } else { var n = 4 }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::ConstantDeclaration("n_0", Expression::Constant(1))),
        AST::Statement(Statement::If(
          Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(2)),
          Statement::Compound([
            AST::Declaration(Declaration::VariableDeclaration("n_1", Expression::Constant(2)))
          ]),
          Option::Some(Statement::If(
            Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(3)),
            Statement::Compound([
              AST::Declaration(Declaration::VariableDeclaration("n_2", Expression::Constant(3)))
            ]),
            Option::Some(Statement::Compound([
              AST::Declaration(Declaration::VariableDeclaration("n_3", Expression::Constant(4)))
            ]))
          ))
        ))
      ]
    }
  )
}

test "Identifier Resolution: Should allow referencing a constant from outer scope in if-else-if statement scopes" {
  val program = parse_line("val n = 1 if 1 < 2 { n } else if 1 < 3 { n } else { n }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      children: [
        AST::Declaration(Declaration::ConstantDeclaration("n_0", Expression::Constant(1))),
        AST::Statement(Statement::If(
          Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(2)),
          Statement::Compound([
            AST::Expression(Expression::Var("n_0"))
          ]),
          Option::Some(Statement::If(
            Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(3)),
            Statement::Compound([
              AST::Expression(Expression::Var("n_0"))
            ]),
            Option::Some(Statement::Compound([
              AST::Expression(Expression::Var("n_0"))
            ]))
          ))
        ))
      ]
    }
  )
}

test "Declaration Hoisting: Should allow calling function before declaration" {
  val program = parse_line("fn main { val n = square(1) } fn square(n int) { return n * n }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      children: [
        AST::Declaration(
          Declaration::FunctionDeclaration(
            "main",
            []Parameter,
            Type::Implicit,
            [
              AST::Declaration(Declaration::ConstantDeclaration("n_0", Expression::FunctionCall("square", [Expression::Constant(1)])))
            ]
          )
        ),
        AST::Declaration(
          Declaration::FunctionDeclaration(
            "square",
            [Parameter { name: "n_1", type: "int" }],
            Type::Implicit,
            [AST::Statement(
              Statement::Return(
                Expression::Binary(BinaryOperator::Multiply, Expression::Var("n_1"), Expression::Var("n_1"))
              )
            )]
          )
        )
      ]
    }
  )
}

test "Declaration Hoisting: Should allow redeclaring a hoisted function in new fn scope" {
  val program = parse_line("fn main { val n = square(1) fn square(n int) { return n * n } } fn square(n int) { return n * n }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      children: [
        AST::Declaration(
          Declaration::FunctionDeclaration(
            "main",
            []Parameter,
            Type::Implicit,
            [
              AST::Declaration(
                Declaration::ConstantDeclaration(
                  "n_0",
                  Expression::FunctionCall(
                    "square",
                    [Expression::Constant(1)]
                  )
                )
              ),
              AST::Declaration(
                Declaration::FunctionDeclaration(
                  "square", 
                  [Parameter { name: "n_1", type: "int" }],
                  Type::Implicit,
                  [AST::Statement(
                    Statement::Return(
                      Expression::Binary(
                        BinaryOperator::Multiply,
                        Expression::Var("n_1"),
                        Expression::Var("n_1")
                      )
                    )
                  )]
                )
              )
            ]
          )
        ),
        AST::Declaration(
          Declaration::FunctionDeclaration(
            "square",
            [Parameter { name: "n_2", type: "int" }],
            Type::Implicit,
            [AST::Statement(
              Statement::Return(
                Expression::Binary(BinaryOperator::Multiply, Expression::Var("n_2"), Expression::Var("n_2"))
              )
            )]
          )
        )
      ]
    }
  )
}

test "Declaration Hoisting: Should allow calling function before declaration in same fn scope" {
  val program = parse_line("fn main { val n = square(1) fn square(n int) { return n * n } }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      children: [
        AST::Declaration(
          Declaration::FunctionDeclaration(
            "main",
            []Parameter,
            Type::Implicit,
            [
              AST::Declaration(
                Declaration::ConstantDeclaration(
                  "n_0",
                  Expression::FunctionCall(
                    "square",
                    [Expression::Constant(1)]
                  )
                )
              ),
              AST::Declaration(
                Declaration::FunctionDeclaration(
                  "square", 
                  [Parameter { name: "n_1", type: "int" }],
                  Type::Implicit,
                  [AST::Statement(
                    Statement::Return(
                      Expression::Binary(
                        BinaryOperator::Multiply,
                        Expression::Var("n_1"),
                        Expression::Var("n_1")
                      )
                    )
                  )]
                )
              )
            ]
          )
        )
      ]
    }
  )
}
