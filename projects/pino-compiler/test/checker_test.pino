  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Declaration(Declaration::ConstantDeclaration("_pino_n_0", Expression::Constant(1), Type::Implicit)),
        AST::Statement(Statement::Match(
          Expression::Constant(1),
          [
            When {
              cond_list: [Expression::Constant(1)],
              block: [
                AST::Statement(Statement::Expression(Expression::Var("_pino_n_0")))
              ]
            }
          ],
          Option::Some([
            AST::Statement(Statement::Expression(Expression::Var("_pino_n_0")))
          ])
        ))
      ]
    }
  )
}

test "Declaration Hoisting: Should allow fn call hoisting (global scope)" {
  val program = parse_line("fn main { a() } fn a {}") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Declaration(
          Declaration::FunctionDeclaration(
            "main",
            []Parameter,
            Type::Implicit,
            [AST::Statement(Statement::Expression(Expression::FunctionCall("_pino_a_0", []Expression)))]
        )
        ),
        AST::Declaration(Declaration::FunctionDeclaration("_pino_a_0", []Parameter, Type::Implicit, []AST))
      ]
    }
  )
}

test "Declaration Hoisting: Should allow fn call hoisting (fn scope)" {
  val program = parse_line("fn main { a() fn a {} }") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Declaration(
          Declaration::FunctionDeclaration(
            "main",
            []Parameter,
            Type::Implicit,
            [
              AST::Statement(
                Statement::Expression(
                  Expression::FunctionCall("_pino_a_0", []Expression)
                )
              ),
              AST::Declaration(
                Declaration::FunctionDeclaration("_pino_a_0", []Parameter, Type::Implicit, []AST)
              )
            ]
          )
        )
      ]
    }
  )
}

test "Declaration Hoisting: Should allow fn call hoisting (if-else-if statement scopes)" {
  val program = parse_line("if 1 < 2 { a() fn a {} } else if 1 < 3 { b() fn b {} } else { c() fn c {} }") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Statement(Statement::If(
          Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(2)),
          Statement::Compound([
            AST::Statement(Statement::Expression(Expression::FunctionCall("_pino_a_0", []Expression))),
            AST::Declaration(Declaration::FunctionDeclaration("_pino_a_0", []Parameter, Type::Implicit, []AST))
          ]),
          Option::Some(Statement::If(
            Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(3)),
            Statement::Compound([
              AST::Statement(Statement::Expression(Expression::FunctionCall("_pino_b_1", []Expression))),
              AST::Declaration(Declaration::FunctionDeclaration("_pino_b_1", []Parameter, Type::Implicit, []AST))
            ]),
            Option::Some(Statement::Compound([
              AST::Statement(Statement::Expression(Expression::FunctionCall("_pino_c_2", []Expression))),
              AST::Declaration(Declaration::FunctionDeclaration("_pino_c_2", []Parameter, Type::Implicit, []AST))
            ]))
          ))
        ))
      ]
    }
  )
}

test "Declaration Hoisting: Should allow fn call hoisting (match when and else scopes)" {
  val program = parse_line("match 1 { when 1 { a() fn a {} } else { b() fn b {} } }") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Statement(Statement::Match(
          Expression::Constant(1),
          [
            When {
              cond_list: [Expression::Constant(1)],
              block: [
                AST::Statement(Statement::Expression(Expression::FunctionCall("_pino_a_0", []Expression))),
                AST::Declaration(Declaration::FunctionDeclaration("_pino_a_0", []Parameter, Type::Implicit, []AST))
              ]
            }
          ],
          Option::Some([
            AST::Statement(Statement::Expression(Expression::FunctionCall("_pino_b_1", []Expression))),
            AST::Declaration(Declaration::FunctionDeclaration("_pino_b_1", []Parameter, Type::Implicit, []AST))
          ])
        ))
      ]
    }
  )
}

test "Identifier Resolution: Should not leak (fn - fn scope)" {
  val program = parse_line("fn main { fn a {} } a()") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Failure("Type Checker Error: Function 'a' has not been declared in the current scope.")
}

test "Identifier Resolution: Should not leak (val - fn scope)" {
  val program = parse_line("fn main { val a = 1 } a") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Failure("Type Checker Error: Variable 'a' has not been declared in the current scope.")
}

