from Utility import pseudo_name_counter
from Entities import Program, AST, Statement, Declaration, Expression, Parameter, BinaryOperator, When, Type, Primitive
from Checker import resolve_program
from Parser import parse_line, parse_decl

test "Identifier Resolution: Should return a valid Program with multiple top-level declarations and expressions" {
  val program = parse_line("val a = 12 var b = 20 b = b + 10 fn add int { val double_n = a * 2 return double_n + b }") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Declaration(Declaration::ConstantDeclaration("_pino_a_1", Expression::Constant(12), Type::Implicit)),
        AST::Declaration(Declaration::VariableDeclaration("_pino_b_2", Expression::Constant(20), Type::Implicit)),
        AST::Statement(Statement::Expression(
          Expression::Assignment(
            Expression::Var("_pino_b_2"),
            Expression::Binary(
              BinaryOperator::Add,
              Expression::Var("_pino_b_2"),
              Expression::Constant(10)
            )
          )
        )),
        AST::Declaration(
          Declaration::FunctionDeclaration(
            "_pino_add_0", 
            []Parameter, 
            Type::Primitive(Primitive::Int), 
            [
              AST::Declaration(
                Declaration::ConstantDeclaration(
                  "_pino_double_n_3",
                  Expression::Binary(
                    BinaryOperator::Multiply,
                    Expression::Var("_pino_a_1"),
                    Expression::Constant(2)
                  ),
                  Type::Implicit
                )
              ),
              AST::Statement(Statement::Return(
                Expression::Binary(
                  BinaryOperator::Add,
                  Expression::Var("_pino_double_n_3"),
                  Expression::Var("_pino_b_2")
                )
              ))
            ]
          )
        )
      ]
    }
  )
}

test "Identifier Resolution: Should catch undeclared entity" {
  val program = parse_line("val a = 1 fn main { return a + b }") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Failure("Type Checker Error: Variable 'b' has not been declared in the current scope.")
}

test "Identifier Resolution: Should catch undeclared function call" {
  val program = parse_line("print()") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Failure("Type Checker Error: Function 'print' has not been declared in the current scope.")
}

test "Identifier Resolution: Should catch declaration self-reference (no shadowing)" {
  val program = parse_line("val a = a") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Failure("Type Checker Error: Variable 'a' has not been declared in the current scope.")
}

test "Identifier Resolution: Should allow declaration self-reference (with shadowing)" {
  val program = parse_line("val a = 1 fn main { val a = a }") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Declaration(Declaration::ConstantDeclaration("_pino_a_0", Expression::Constant(1), Type::Implicit)),
        AST::Declaration(Declaration::FunctionDeclaration("main", []Parameter, Type::Implicit, [
          AST::Declaration(Declaration::ConstantDeclaration("_pino_a_1", Expression::Var("_pino_a_0"), Type::Implicit))
        ]))
      ]
    }
  )
}

test "Identifier Resolution: Should catch redeclaring (fn -> fn)" {
  val program = parse_line("fn a {} fn a {}") or {
    assert false
  }
  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Failure("Type Checker Error: Function 'a' has been already declared in the current scope.")
}

