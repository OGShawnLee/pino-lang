        AST::Declaration(Declaration::FunctionDeclaration("main", []Parameter, Type::Implicit, [
          AST::Declaration(Declaration::FunctionDeclaration("_pino_a_1", []Parameter, Type::Implicit, []AST))
        ]))
      ]
