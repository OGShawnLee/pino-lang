test "Identifier Resolution: Should allow shadowing (fn -> val) in if-else-if statement scopes" {
  val program = parse_line("fn n {} if 1 < 2 { val n = 2 } else if 1 < 3 { val n = 3 } else { val n = 4 }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Declaration(Declaration::FunctionDeclaration("n", []Parameter, Option::None, []AST)),
        AST::Statement(Statement::If(
          Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(2)),
          Statement::Compound([
            AST::Declaration(Declaration::ConstantDeclaration("n_0", Expression::Constant(2)))
          ]),
          Option::Some(Statement::If(
            Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(3)),
            Statement::Compound([
              AST::Declaration(Declaration::ConstantDeclaration("n_1", Expression::Constant(3)))
            ]),
            Option::Some(Statement::Compound([
              AST::Declaration(Declaration::ConstantDeclaration("n_2", Expression::Constant(4)))
            ]))
          ))
        ))
      ]
    }
  )
}

test "Identifier Resolution: Should allow referencing a constant from outer scope in if-else-if statement scopes" {
  val program = parse_line("val n = 1 if 1 < 2 { n } else if 1 < 3 { n } else { n }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Declaration(Declaration::ConstantDeclaration("n_0", Expression::Constant(1))),
        AST::Statement(Statement::If(
          Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(2)),
          Statement::Compound([
            AST::Statement(Statement::Expression(Expression::Var("n_0")))
          ]),
          Option::Some(Statement::If(
            Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(3)),
            Statement::Compound([
              AST::Statement(Statement::Expression(Expression::Var("n_0")))
            ]),
            Option::Some(Statement::Compound([
              AST::Statement(Statement::Expression(Expression::Var("n_0")))
            ]))
          ))
        ))
      ]
    }
  )
}

test "Identifier Resolution: Should allow shadowing (val -> val) in match when and else scopes" {
  val program = parse_line("val n = 1 match 1 { when 1 { val n = 2 } when 2 { val n = 3 } else { val n = 4 } }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Declaration(Declaration::ConstantDeclaration("n_0", Expression::Constant(1))),
        AST::Statement(Statement::Match(
          Expression::Constant(1),
          [
            When {
              cond_list: [Expression::Constant(1)],
              block: [
                AST::Declaration(Declaration::ConstantDeclaration("n_1", Expression::Constant(2)))
              ]
            },
            When {
              cond_list: [Expression::Constant(2)],
              block: [
                AST::Declaration(Declaration::ConstantDeclaration("n_2", Expression::Constant(3)))
              ]
            }
          ],
          Option::Some([
            AST::Declaration(Declaration::ConstantDeclaration("n_3", Expression::Constant(4)))
          ])
        ))
      ]
    }
  )
}

