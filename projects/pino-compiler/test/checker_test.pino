  pseudo_name_counter:reset()
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Declaration(Declaration::ConstantDeclaration("_pino_n_0", Expression::Constant(1), Type::Implicit)),
        AST::Statement(Statement::If(
          Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(2)),
          Statement::Compound([
            AST::Declaration(Declaration::FunctionDeclaration("_pino_n_1", []Parameter, Type::Implicit, []AST))
          ]),
          Option::Some(Statement::If(
            Expression::Binary(BinaryOperator::LessThan, Expression::Constant(1), Expression::Constant(3)),
            Statement::Compound([
              AST::Declaration(Declaration::FunctionDeclaration("_pino_n_2", []Parameter, Type::Implicit, []AST))
            ]),
            Option::Some(Statement::Compound([
              AST::Declaration(Declaration::FunctionDeclaration("_pino_n_3", []Parameter, Type::Implicit, []AST))
            ]))
          ))
        ))
      ]
    }
  )
}

