test "Identifier Resolution: Should allow declaration (fn -> fn) (fn scope)" {
  val program = parse_line("fn a {} fn main { fn a {} }") or {
    assert false
  }
  pseudo_name_counter[0] = 0
  val program_checked = resolve_program(program)
  assert program_checked == Result::Success(
    Program {
      content: [
        AST::Declaration(Declaration::FunctionDeclaration("a", []Parameter, Option::None, []AST)),
        AST::Declaration(Declaration::FunctionDeclaration("main", []Parameter, Option::None, [
          AST::Declaration(Declaration::FunctionDeclaration("a", []Parameter, Option::None, []AST))
        ]))
      ]
    }
  )
}

