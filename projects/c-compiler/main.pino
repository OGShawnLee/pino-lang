from Lexer import TokenType, TokenStream, lex_line_list
from Parser import parse
from Checker import resolve_ast, label_ast, type_check_ast
from Transformer import translate_ast_to_tacky
from Printer import print_ast, print_tacky, print_asm
from Translator import translate_ast_to_asm
from Compiler import compile_ast_to_asm

fn get_file_lines() Result[[]string, string]{
	val content = read_file("projects/c-compiler/main.c") or {
		println(err)
		return Result::Failure("Unable to read 'main.c'.")
	}

	return Result::Success(content:split("\n"))
}

fn main {
	val begin = time()
	println("Welcome to the Pino C Compiler!")

	val line_list = get_file_lines() or {
		panic(err)
	}

	val token_stream = lex_line_list(line_list) or {
		panic(err)
	}

	val program_ast = parse(token_stream) or {
		panic(err)
	}
	println("Abstract Syntax Tree (RAW):")
	print_ast(program_ast, 0)

	val resolved_program_ast = resolve_ast(program_ast) or {
		panic(err)
	}

	println("Abstract Syntax Tree (VARIABLE RESOLUTION PASSED):")
	
	val variable_map = type_check_ast(resolved_program_ast) or {
		panic(err)
	}

	println("Abstract Syntax Tree (TYPE CHECKING PASSED):")
	println("Symbol Table")
	println(variable_map)

	val labeled_program_ast = label_ast(resolved_program_ast) or {
		panic(err)
	}

	println("Abstract Syntax Tree (LOOP LABELING PASSED):")
	print_ast(labeled_program_ast, 0)

	val program_tacky = translate_ast_to_tacky(labeled_program_ast)

	println("Intermediate Representations (TACKY):")
	print_tacky(program_tacky, 0)

	val assembly_ast = translate_ast_to_asm(program_tacky)

	println("Raw Assembly AST")
	print_asm(assembly_ast, 0)

	val assembly = compile_ast_to_asm(assembly_ast)

	println("ASM Output:")
	println(assembly)

	write_file("projects/c-compiler/main.s", assembly) or {
		panic("Unable to write Assembly Output to 'main.s'")
	}
	
	println("Done in $(time() - begin) ms")
}