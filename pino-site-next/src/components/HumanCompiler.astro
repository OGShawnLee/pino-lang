---
const acts = [
  {
    num: "01",
    roman: "I",
    chapter: "The Missing Semicolon",
    subtitle: "Syntax without punishment",
    story:
      "In 2024, at Universidad Veracruzana, a semester exam was failed because of a single missing semicolon in C++. Pino was conceived so syntax would never again act as an adversary.",
    principle:
      "Commas and semicolons are completely optional. No mandatory parentheses around control flow. The compiler interprets human intention rather than penalizing it.",
    badge: "Ergonomics",
    accent: "text-[#E59728]",
    tagBg: "bg-[#E59728]/10 text-[#E59728]",
  },
  {
    num: "02",
    roman: "II",
    chapter: "The Four-Gigabyte Laptop",
    subtitle: "Self-contained frugality",
    story:
      "Student machines with 4 GB of RAM were being choked by 15 GB corporate SDKs and IDE toolchains. Pino was architected to be completely self-contained from day one.",
    principle:
      "A single, compact toolbelt executable producing standalone native binaries as small as ~3 KB. No monstrous background daemons; supreme respect for hardware.",
    badge: "Frugality",
    accent: "text-[#2D6A4F]",
    tagBg: "bg-[#2D6A4F]/10 text-[#2D6A4F]",
  },
  {
    num: "03",
    roman: "III",
    chapter: "Data Science Late Nights",
    subtitle: "Gentle static rigor",
    story:
      "Born out of empathy for data science workflows—where scripting speed is vital, yet a silent dynamic runtime crash at 3 AM can ruin hours of computational modeling.",
    principle:
      "The fluid expression of functional pipelines (.map, .filter) paired with algebraic sum types and errors as values. Confident code that watches over your work.",
    badge: "Safety",
    accent: "text-[#3B57C4]",
    tagBg: "bg-[#3B57C4]/10 text-[#3B57C4]",
  },
];
---

<section
  id="manifesto"
  class="w-full px-6 sm:px-12 max-w-7xl mx-auto py-24 sm:py-32 border-t border-[#2C241D]/10"
>
  <!-- 1. Gran Epígrafe Editorial (Manifiesto de Apertura) -->
  <div class="max-w-4xl mx-auto text-center space-y-6 pb-16 sm:pb-20">
    <div class="flex items-center justify-center gap-3 text-[10px] font-mono tracking-widest text-[#2C241D]/40 uppercase select-none">
      <span>THE HUMAN COMPILER</span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#E59728]"></span>
      <span>FOLIO 02</span>
    </div>

    <blockquote class="text-3xl sm:text-5xl lg:text-6xl font-serif-editorial italic font-light tracking-tight text-[#2C241D] leading-[1.08]">
      “Born so no one ever fails an exam over a missing semicolon again.
      <span class="block mt-2 font-normal text-[#E59728]">
        Swift on silicon, gentle with humans.”
      </span>
    </blockquote>

    <p class="text-xs sm:text-sm font-mono tracking-wider text-[#2C241D]/60 uppercase pt-2 select-none">
      — Founding Principle // Universidad Veracruzana, 2024
    </p>
  </div>

  <!-- 2. Lámina de Arte: Acuarela de los Viajeros (Plate 02) -->
  <div class="pb-20 sm:pb-28">
    <div class="bg-white p-5 sm:p-8 pb-8 rounded-sm shadow-[0_16px_48px_rgba(44,36,29,0.07)] border border-[#2C241D]/10 relative group transition-all duration-300 hover:shadow-[0_20px_56px_rgba(44,36,29,0.11)] max-w-5xl mx-auto">
      <!-- Lateral metadata tag -->
      <div class="absolute -left-8 top-1/2 -translate-y-1/2 -rotate-90 hidden lg:block text-[9px] font-mono tracking-widest text-[#2C241D]/40 uppercase select-none">
        PLATE 02 // CHRONICLES OF AN AWAKENING
      </div>

      <!-- Image Container -->
      <div class="aspect-16/10 rounded-xs overflow-hidden bg-[#FAF7F2] border border-[#2C241D]/6 relative flex items-center justify-center p-6 sm:p-10">
        <img
          src="/assets/trio_watercolor_pure.jpg"
          alt="Re-l Mayer, Vincent Law, and Pino in Hand-painted Watercolor"
          class="w-full h-full object-contain select-none"
          loading="lazy"
        />
      </div>

      <!-- Plate Caption -->
      <div class="mt-4 flex flex-col sm:flex-row sm:items-baseline justify-between pt-3 border-t border-[#2C241D]/8 gap-2">
        <div>
          <span class="font-serif-editorial italic text-lg sm:text-xl text-[#2C241D] block leading-tight">
            Plate 02: The Travelers
          </span>
          <span class="text-[10px] font-mono text-[#2C241D]/50 uppercase tracking-widest">
            Re-l Mayer, Vincent Law & Pino · Traditional Watercolor on
            Cold-Press Paper
          </span>
        </div>
        <span class="text-[10px] font-mono text-[#E59728] font-bold">
          Ergo Proxy Legacy
        </span>
      </div>
    </div>
  </div>

  <!-- 3. Los Tres Actos: Tarjetas Editoriales de Gran Formato (Historia → Principio) -->
  <div class="space-y-12">
    <!-- Header del Tríptico -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-[#2C241D]/10">
      <div>
        <span class="text-[10px] font-mono tracking-widest text-[#2C241D]/40 uppercase block mb-1">
          CHRONICLES & PRINCIPLES
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif-editorial font-light tracking-tight text-[#2C241D]">
          Three Moments, Three Foundations
        </h2>
      </div>
      <p class="text-xs font-mono text-[#2C241D]/50 uppercase tracking-widest text-left sm:text-right">
        How human circumstance shaped language architecture.
      </p>
    </div>

    <!-- Grid de 3 Tarjetas Espaciosas y Editoriales -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {acts.map((item) => (
        <article class="bg-white/80 border border-[#2C241D]/12 p-8 sm:p-10 rounded-sm shadow-[0_8px_24px_rgba(44,36,29,0.04)] flex flex-col justify-between space-y-8 transition-all duration-300 hover:bg-white hover:border-[#E59728]/40 hover:shadow-[0_16px_36px_rgba(44,36,29,0.08)]">
          <!-- Top metadata and Act Number -->
          <div class="space-y-5">
            <div class="flex items-center justify-between border-b border-[#2C241D]/8 pb-4">
              <span class="text-2xl sm:text-3xl font-serif-editorial italic text-[#2C241D]/90 font-normal">
                Act {item.roman}.
              </span>
              <span
                class={`text-[10px] font-mono tracking-widest uppercase px-2.5 py-1 rounded-xs font-semibold ${item.tagBg}`}
              >
                {item.badge}
              </span>
            </div>

            <!-- Chapter Titles -->
            <div>
              <h3 class="text-2xl font-serif-editorial font-normal tracking-tight text-[#2C241D] leading-snug">
                {item.chapter}
              </h3>
              <span
                class={`text-xs font-mono tracking-wider uppercase block mt-1 ${item.accent}`}
              >
                {item.subtitle}
              </span>
            </div>

            <!-- The Human Origin Story -->
            <div class="space-y-2 pt-2">
              <span class="text-[9px] font-mono tracking-widest text-[#2C241D]/40 uppercase block">
                The Circumstance
              </span>
              <p class="text-sm font-sans text-[#2C241D]/75 leading-relaxed font-light">
                {item.story}
              </p>
            </div>
          </div>

          <!-- The Architectural Answer (Pino's design) -->
          <div class="pt-6 border-t border-[#2C241D]/8 space-y-2 bg-[#F5F2EB]/40 -mx-8 -mb-8 sm:-mx-10 sm:-mb-10 p-6 sm:p-8 rounded-b-sm">
            <span class="text-[9px] font-mono tracking-widest text-[#2C241D]/40 uppercase block">
              Architectural Answer
            </span>
            <p class="text-xs sm:text-sm font-serif-editorial italic text-[#2C241D]/90 leading-relaxed">
              “{item.principle}”
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
