---
// A few slow falling pine needles. Decorative; place it inside a positioned container.
// It pauses off screen and in background tabs, and stays still when the visitor asks for reduced motion.
---

<canvas class="needles" aria-hidden="true"></canvas>

<style>
  .needles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  type Needle = {
    x: number; y: number; vy: number; a: number; va: number;
    sway: number; ph: number; n: number; len: number; o: number;
  };

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    const box = canvas.parentElement;
    if (!ctx || !box) return;

    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    let W = 0, H = 0, color = "45 90 67";
    let seed = 7;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;

    const resize = () => {
      const dpr = Math.min(2, devicePixelRatio || 1);
      W = box.clientWidth; H = box.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      color = getComputedStyle(canvas).getPropertyValue("--needle").trim() || color;
    };
    resize();

    const make = (y?: number): Needle => ({
      x: rnd() * W, y: y ?? rnd() * H, vy: 0.18 + rnd() * 0.22, a: rnd() * 6.28, va: (rnd() - 0.5) * 0.006,
      sway: 8 + rnd() * 14, ph: rnd() * 6.28, n: 2 + Math.floor(rnd() * 3), len: 11 + rnd() * 9, o: 0.22 + rnd() * 0.22,
    });
    const count = W < 640 ? 6 : 11;
    const needles = Array.from({ length: count }, () => make());

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      for (const p of needles) {
        const x = p.x + Math.sin(p.ph + p.y / 60) * p.sway;
        ctx.save();
        ctx.translate(x, p.y);
        ctx.rotate(p.a + Math.sin(p.ph + p.y / 90) * 0.3);
        ctx.strokeStyle = `rgb(${color} / ${p.o})`;
        ctx.lineWidth = 1;
        ctx.lineCap = "round";
        for (let i = 0; i < p.n; i++) {
          const ang = (i - (p.n - 1) / 2) * 0.22;
          ctx.beginPath();
          ctx.moveTo(0, 0);
          ctx.quadraticCurveTo(Math.sin(ang) * p.len * 0.5 + 1, -p.len * 0.5, Math.sin(ang) * p.len, -Math.cos(ang) * p.len);
          ctx.stroke();
        }
        ctx.restore();
      }
    };

    let visible = true, frame = 0;
    const step = () => {
      for (const p of needles) {
        p.y += p.vy; p.a += p.va;
        if (p.y > H + 30) Object.assign(p, make(-30));
      }
      draw();
      frame = visible && !reduce.matches && !document.hidden ? requestAnimationFrame(step) : 0;
    };
    const resume = () => { if (!frame && visible && !reduce.matches && !document.hidden) frame = requestAnimationFrame(step); };

    draw();
    resume();
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; resume(); }).observe(canvas);
    document.addEventListener("visibilitychange", resume);
    reduce.addEventListener("change", resume);
    addEventListener("resize", () => { resize(); draw(); });
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { resize(); draw(); });
  }

  document.querySelectorAll<HTMLCanvasElement>("canvas.needles").forEach(start);
</script>
