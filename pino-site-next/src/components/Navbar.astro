---

<header class="w-full pt-8 sm:pt-10 px-6 sm:px-12 max-w-7xl mx-auto">
  <div class="flex items-center justify-between pb-6 border-b border-[#2C241D]/12">
    <!-- Editorial Folio / Magazine Metadata -->
    <div class="flex items-center gap-4 text-[11px] font-mono tracking-widest uppercase text-[#2C241D]/60 select-none">
      <span>NO. 001</span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#E59728]"></span>
      <span class="hidden sm:inline">VOL. 0.3.2</span>
    </div>

    <!-- Center Brand: Pino with refined serif italics -->
    <a
      href="/"
      class="text-2xl sm:text-3xl font-serif-editorial italic font-normal tracking-tight text-[#2C241D] hover:text-[#E59728] transition-colors no-underline"
    >
      Pino.
    </a>

    <!-- Minimal Nav and GitHub Link -->
    <div class="flex items-center gap-6 sm:gap-8 text-xs font-mono tracking-widest uppercase text-[#2C241D]/75">
      <nav class="hidden md:flex items-center gap-6">
        <a href="#about" class="hover:text-[#E59728] transition-colors no-underline">About</a>
        <a href="#manifesto" class="hover:text-[#E59728] transition-colors no-underline">The Human Compiler</a>
        <a href="#reality" class="hover:text-[#E59728] transition-colors no-underline">Reality Check</a>
        <a href="#engines" class="hover:text-[#E59728] transition-colors no-underline">Engines</a>
      </nav>

      <a
        href="https://github.com/OGShawnLee/pino-lang"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 hover:text-[#2C241D] transition-colors no-underline text-[#2C241D]/80"
      >
        <span>GitHub</span>
        <span class="text-[10px] transform -translate-y-0.5">↗</span>
      </a>
    </div>
  </div>
</header>
