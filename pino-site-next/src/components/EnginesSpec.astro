---
const runtimes = [
  {
    tier: "CURRENT · STABLE",
    title: "Tree-Walk Reference",
    version: "v0.3.2",
    engine: "C# (.NET 10.0)",
    command: "pino run main.pino",
    note: "The complete reference engine. Lexical analysis, recursive-descent parsing, and thorough static type-checking prior to evaluation.",
    status: "Stable",
    statusColor: "text-[#2D6A4F]",
  },
  {
    tier: "EXPERIMENTAL",
    title: "Bytecode Virtual Machine",
    version: "--vm flag",
    engine: "Stack-Based VM",
    command: "pino run --vm main.pino",
    note: "Custom stack-based virtual machine with direct bytecode emission, designed for swift iteration cycles and script execution.",
    status: "In Progress",
    statusColor: "text-[#E59728]",
  },
  {
    tier: "HORIZON",
    title: "Self-Hosted C Transpiler",
    version: "v0.4.0 Target",
    engine: "Pino → C (Tiny C Compiler)",
    command: "pino compile main.pino",
    note: "Pino written entirely in Pino! Transpiles to clean C source code linked with Tiny C Compiler (TCC) for ~3 KB native standalone binaries.",
    status: "Roadmap",
    statusColor: "text-[#3B57C4]",
  },
];
---

<section id="engines" class="w-full px-6 sm:px-12 max-w-7xl mx-auto py-20 sm:py-24 border-t border-[#2C241D]/10">
  <!-- Section Header -->
  <div class="space-y-2 pb-10">
    <span class="text-[10px] font-mono tracking-widest text-[#2C241D]/40 uppercase block">
      SPECIFICATION // ENGINES
    </span>
    <h2 class="text-3xl sm:text-4xl font-serif-editorial font-light tracking-tight text-[#2C241D]">
      Execution Engines
    </h2>
    <p class="text-sm text-[#2C241D]/60 max-w-xl font-light">
      A disciplined, pragmatic compiler roadmap. Complete transparency regarding the technical status of each layer in real time.
    </p>
  </div>

  <!-- Editorial 3-Column Table -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {runtimes.map((item) => (
      <div class="border border-[#2C241D]/10 bg-white/40 p-7 rounded-sm flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-[#2C241D]/8 pb-3">
            <span class="text-[9px] font-mono tracking-widest uppercase text-[#2C241D]/40">
              {item.tier}
            </span>
            <span class={`text-[10px] font-mono uppercase font-bold ${item.statusColor}`}>
              {item.status}
            </span>
          </div>

          <div>
            <span class="text-xs font-mono text-[#E59728] block mb-1">
              {item.version}
            </span>
            <h3 class="text-xl font-serif-editorial font-normal tracking-tight text-[#2C241D]">
              {item.title}
            </h3>
            <span class="text-[11px] font-mono text-[#2C241D]/50 block mt-0.5">
              {item.engine}
            </span>
          </div>

          <p class="text-xs text-[#2C241D]/70 leading-relaxed font-light">
            {item.note}
          </p>
        </div>

        <div class="pt-4 border-t border-[#2C241D]/8 bg-[#F5F2EB]/50 p-2.5 rounded-xs font-mono text-[11px] text-[#2C241D]/80 truncate">
          <span class="text-[#E59728] mr-1.5 select-none">$</span>
          <span>{item.command}</span>
        </div>
      </div>
    ))}
  </div>
</section>
