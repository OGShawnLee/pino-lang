---
// Styled wrapper for rendered Markdown guide pages.
---

<div class="prose">
  <slot />
</div>

<style>
  .prose :global(h1) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .prose :global(h2) {
    font-size: clamp(1.6rem, 3.6vw, 2.1rem);
    line-height: 1.15;
    margin: 3.5rem 0 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .prose :global(h3) {
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 2.2rem 0 0.6rem;
  }
  .prose :global(:is(p, ul, ol, table, pre, blockquote)) {
    margin: 0 0 1rem;
  }
  .prose :global(:is(p, li)) {
    max-width: 42rem;
  }
  .prose :global(li + li) {
    margin-top: 0.3rem;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .prose :global(a:hover) {
    color: var(--pine);
  }
  .prose :global(:not(pre) > code) {
    font-size: 0.9em;
    background: var(--code-bg);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
  .prose :global(pre) {
    margin: 0 0 1rem;
    padding: 1.1rem 1.2rem;
    font-size: 0.82rem;
    line-height: 1.65;
    overflow-x: auto;
    tab-size: 2;
    --shiki-background: var(--code-bg);
    background: var(--code-bg);
    border: 1px solid var(--line);
  }
  .prose :global(table) {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.92rem;
    display: block;
    overflow-x: auto;
  }
  .prose :global(:is(th, td)) {
    padding: 0.55rem 0.9rem 0.55rem 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(th) {
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--pine);
    padding-left: 1rem;
    color: var(--soft);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2.5rem 0;
  }
</style>
