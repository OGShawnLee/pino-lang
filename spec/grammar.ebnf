(* Pino Lang grammar. Normative companion to spec/SPEC.md.

   Notation: ISO-style EBNF.
     =            definition             ;   end of production
     ,            concatenation          |   alternation
     [ x ]        optional               { x }  zero or more repetitions
     ( x )        grouping               open-paren-star ... star-close-paren  comment
     "text"       quoted terminal (keyword, operator or marker)
     UPPERCASE    token class produced by the lexer: IDENT, INT, FLOAT, STRING, RUNE

   One delimited section per feature-table row of spec/SPEC.md, in table order:
     a marker comment: section, colon, lower-case rule prefix, then (owner <ticket>), between === rules
   Sections containing only the word pending are filled in by their owner ticket.
   Productions describe what the parser accepts today; where that differs from
   LANGUAGE_REFERENCE.md, the reference is followed and a comment points to the decision file. *)

(* === section: lex (owner 005) === *)
(* Tokens. Whitespace and newlines separate tokens and are otherwise insignificant. *)
comment         = "#" , { any_char_except_newline } ;      (* runs to the end of the line *)

IDENT           = ident_start , { ident_start | digit } ;
ident_start     = letter | "_" ;                          (* D-021: the lexer also accepts "$" in identifiers *)
keyword         = "var" | "val" | "fn" | "if" | "else" | "match" | "when" | "for"
                | "struct" | "enum" | "break" | "continue" | "return" ;
                  (* the lexer reserves more words (import, from, module, pub, static, union, yield, is, as, in,
                     then, test, assert, interface); only the ones asserted by LexerTests are normative here *)

INT             = digit , { digit | "_" , digit , digit , digit } ;   (* 42, 1_000_000 *)
FLOAT           = INT , "." , digit , { digit } ;                     (* 3.14159; a leading "-" is the unary operator *)
BOOL            = "true" | "false" ;
STRING          = '"' , { string_char | interpolation } , '"' ;       (* see section str *)
RUNE            = "'" , ( rune_char | "\n" | "\'" ) , "'" ;           (* one Unicode code point *)

(* Optional commas (reference section 1). In every list below a separator is "," or nothing:
   D-010: when the separator is omitted, "a -b" is read as the subtraction "a - b". *)
list_sep        = [ "," ] ;
vector_literal  = "[" , [ expression , { list_sep , expression } ] , "]" ;
map_literal     = "map" , "[" , type_expr , "," , type_expr , "]" , "{" , [ map_entry , { list_sep , map_entry } ] , "}" ;
map_entry       = expression , ":" , expression ;
struct_init     = IDENT , "{" , [ field_init , { list_sep , field_init } ] , "}" ;
field_init      = IDENT , ":" , expression ;
import_stmt     = "from" , IDENT , "import" , IDENT , { list_sep , IDENT } ;
when_values     = "when" , expression , { list_sep , expression } ;
param_list      = "(" , [ param , { list_sep , param } ] , ")" ;
param           = IDENT , type_expr ;
arg_list        = "(" , [ expression , { list_sep , expression } ] , ")" ;

(* === section: var (owner 005) === *)
(* D-012: the reference gives no syntax for an explicit type annotation, and neither `val x: int = 10`
   nor `val x int = 10` parses today, so none is listed. D-018: the parser accepts a second declaration of the
   same name in one scope. *)
variable_decl   = ( "val" | "var" ) , IDENT , "=" , expression ;

assignment      = assign_target , assign_op , expression ;
assign_target   = IDENT | index_expr | member_expr ;       (* x, v[i], m["k"], obj:field *)
assign_op       = "=" | "+=" | "-=" | "*=" | "/=" | "%=" ;
                  (* assigning to a val is an error (D-017); the checker rejects a value of another type.
                     `block` (a braced statement list that opens a nested scope) is defined with the statements. *)

(* === section: type (owner 005) === *)
(* D-012: no explicit annotation syntax is accepted for variables. Type names appear after a parameter name
   (`a int`) and as return types; compound type forms (vectors, maps, functions, generics) belong to later sections. *)
primitive_type  = "bool" | "int" | "float" | "rune" | "string" ;
type_expr       = primitive_type
                | IDENT ;                                (* struct, interface, enum or union name; other forms: later sections *)

(* Operators on primitive values, from loosest to tightest binding. Only the orderings asserted by
   ArithmeticTests are normative: `*` `/` before `+` `-`, unary operators before binary ones, `not` before `and`. *)
or_expr         = and_expr , { "or" , and_expr } ;        (* right operand evaluated only when needed *)
and_expr        = eq_expr , { "and" , eq_expr } ;
eq_expr         = cmp_expr , { ( "==" | "!=" | "===" | "!==" ) , cmp_expr } ;   (* equality: see section eq *)
cmp_expr        = add_expr , { ( "<" | "<=" | ">" | ">=" ) , add_expr } ;
add_expr        = mul_expr , { ( "+" | "-" ) , mul_expr } ;
mul_expr        = unary_expr , { ( "*" | "/" | "%" ) , unary_expr } ;
unary_expr      = ( "-" | "not" ) , unary_expr
                | primary_expr ;
primary_expr    = INT | FLOAT | BOOL | STRING | RUNE | IDENT | "(" , expression , ")" | call_expr ;
call_expr       = IDENT , arg_list ;                      (* includes the builtins type(v), int(v), float(v), rune(v), str(v) *)

(* === section: rune (owner 005) === *)
(* Rune literals are the RUNE token (see section lex). Runes use the operators of section type; the result type
   depends on the operand types (RUNE-2, RUNE-3). D-011: `rune + rune` is not specified here. *)
rune_shift      = rune_expr , ( "+" | "-" ) , int_expr ;      (* rune: 'A' + 1 *)
rune_distance   = rune_expr , "-" , rune_expr ;               (* int:  'c' - 'a' *)
rune_compare    = rune_expr , ( "==" | "!=" | "<" | "<=" | ">" | ">=" ) , rune_expr ;
rune_expr       = expression ;                                (* any expression of type rune *)
int_expr        = expression ;                                (* any expression of type int *)

rune_call       = "rune" , "(" , expression , ")" ;           (* int or string argument; first character of a string *)
str_call        = "str" , "(" , expression , ")" ;            (* see section str *)

(* === section: str (owner 005) === *)
(* A string literal is lexed into text pieces and interpolations. D-020: escape sequences are undocumented;
   D-021: `$` is also accepted inside identifiers. A string literal does not span lines. *)
string_literal  = '"' , { string_piece } , '"' ;
string_piece    = string_text
                | "$" , IDENT                             (* $name: variable interpolation *)
                | "$(" , expression , ")" ;               (* $(expr): expression interpolation *)
string_text     = { any_char_except_quote_and_dollar } ;  (* `\"` `\\` `\$` `\n` `\t` `\r`: see D-020 *)

string_concat   = expression , "+" , expression ;         (* both operands strings: concatenation *)
str_conversion  = "str" , "(" , expression , ")" ;        (* textual representation of any value *)

(* === section: eq (owner 005) === *)
(* The four operators are the equality level `eq_expr` of section type; this section states their operand types
   and meaning. Tuples (`@(a, b)`) take no part in equality (reference section 3, "Tuple Constraint"). *)
structural_eq   = expression , ( "==" | "!=" ) , expression ;      (* primitives, vectors, maps, structs, unions, enums, regex *)
identity_eq     = expression , ( "===" | "!==" ) , expression ;    (* scalars by value, heap objects by reference *)

(* === section: if (owner 006) === *)
if_statement  = "if" , expression , block , [ "else" , ( if_statement | else_body ) ] ;
else_body     = block
              | "=>" , expression ;           (* D-035: the parser also accepts `else => expr` after an `if` block;
                                                 the reference documents only `else { ... }` *)

if_expression = "if" , expression , "then" , expression , "else" , expression ;
                                              (* value-producing form; the `else` part is mandatory (IF-E2).
                                                 The condition is not required to be of type bool (D-032). *)

(* === section: loop (owner 004) === *)
(* Productions below reference `block`, `statement` and `expression`, which belong to later sections. *)
loop_statement  = "for" , loop_head , block ;

loop_head       = (* empty: infinite loop, `for { ... }` *)
                | expression                  (* `for N { ... }` count form, or `for cond { ... }` condition form *)
                | loop_binding , "in" , expression ;   (* `for x in coll { ... }`, `for i, x in coll { ... }` *)

(* The parser always reads a bare `for <expression> {` as the count form; the checker
   re-classifies it as the condition form when the expression has type bool. *)

loop_binding    = IDENT
                | IDENT , "," , IDENT ;       (* key/index first, then value. D-001: the reference says commas are
                                                 optional in lists, but the parser requires the comma here. *)

break_statement    = "break" ;
continue_statement = "continue" ;

(* === section: match (owner 006) === *)
(* `match` is both a statement and an expression: the same production is used wherever the parser expects
   a statement or an expression. In expression position the arms yield the value of the match. *)
match_expression = "match" , expression , "{" , { when_arm } , [ else_arm ] , "}" ;

when_arm         = "when" , pattern , { [ "," ] , pattern } , arm_body ;
                                              (* the commas between patterns are optional (MATCH-3) *)
else_arm         = "else" , arm_body ;
arm_body         = block                      (* block arm; in expression position it ends with `yield expr` *)
                 | "=>" , expression ;        (* single-expression arm; `=>` before a block is a parse error (MATCH-E4) *)

pattern          = variant_pattern
                 | IDENT                      (* D-034: parsed as a binding that matches any value *)
                 | "true" | "false"
                 | expression ;               (* literal value, for example `1`, `"start"` *)

variant_pattern  = IDENT , [ "[" , type_list , "]" ] , "::" , IDENT , [ "(" , { pattern , [ "," ] } , ")" ] ;
                                              (* `Enum::Member`, or `Union::Variant(sub-patterns)` *)
type_list        = type_name , { "," , type_name } ;
type_name        = IDENT ;                    (* simplified; full type syntax belongs to the type section *)

(* === section: main (owner 006) === *)
(* The entry point is an ordinary function named `main`; no dedicated syntax exists.
   Productions for functions belong to section `fn` (owner 007). *)
main_declaration = "fn" , "main" , [ "(" , [ parameter_list ] , ")" ] , [ type_name ] , block ;
                                              (* `fn main() { ... }` or `fn main { ... }`. Parameters are parsed
                                                 but the automatic call is skipped for them (D-036). *)

(* Script mode: the file contains no `main_declaration`; every top-level item runs in order (MAIN-1). *)
script_file      = { statement } ;

(* Program mode: the root file contains a `main_declaration`. The checker then restricts the top level
   (MAIN-3, MAIN-4, MAIN-E1..E3). `main` runs automatically after the file has been loaded (MAIN-2). *)
program_file     = { program_item } ;
program_item     = struct_declaration | interface_declaration | enum_declaration | union_declaration
                 | function_declaration | import_statement | module_declaration | test_declaration
                 | "val" , IDENT , [ type_name ] , "=" , expression ;

(* === section: fn (owner 007) === *)
(* Productions below reference `type`, `block` and `expression`, which belong to other sections. *)
function_declaration = [ visibility ] , "fn" , IDENT , parameters , [ return_type ] , block ;

visibility      = "pub" | "@pub_testing" ;    (* mutually exclusive; see section mod *)

parameters      = (* empty: only when the next token is "{" *)
                | "(" , [ parameter , { [ "," ] , parameter } ] , ")" ;   (* commas optional, see D-051 *)

parameter       = IDENT , type ;              (* a parameter named like a keyword, e.g. `val`, is rejected: D-054 *)

return_type     = type | tuple_type ;         (* tuple_type: section tup *)

lambda_expression = "fn" , parameters , ( "=>" , expression | block ) ;
                                              (* D-052: `fn name(...) => expr` and D-053: a lambda return type are not accepted *)

function_type   = "fn" , "(" , [ type , { [ "," ] , type } ] , ")" , [ type | tuple_type ] ;

call_expression = IDENT , [ "[" , type , { [ "," ] , type } , "]" ] , "(" , [ argument , { [ "," ] , argument } ] , ")" ;

argument        = expression ;                (* an argument that uses an undeclared `it` becomes an implicit
                                                 one-parameter lambda `fn (it) => <argument>`; D-002 *)

return_statement = "return" , [ expression ] ;

(* === section: tup (owner 007) === *)
tuple_type      = "@" , "(" , tuple_field_type , { [ "," ] , tuple_field_type } , ")" ;   (* function return position only *)
tuple_field_type = IDENT , type ;

tuple_literal   = "@" , "(" , tuple_field , { [ "," ] , tuple_field } , ")" ;
tuple_field     = IDENT , ":" , expression    (* labeled *)
                | IDENT ;                     (* shorthand for `IDENT : IDENT` *)

tuple_destructuring = ( "val" | "var" ) , "@" , "(" , destructure_field , { [ "," ] , destructure_field } , ")" , "=" , expression ;
destructure_field = IDENT                     (* label and variable have the same name *)
                  | IDENT , ":" , IDENT ;     (* label, then the variable that receives it *)

(* The parser accepts a tuple literal anywhere an expression may appear; the checker restricts it to the
   expression of a `return` statement (TUP-E1, TUP-E2). *)

(* === section: vec (owner 007) === *)
vector_expression = "[" , [ expression , { [ "," ] , expression } ] , "]"    (* literal *)
                  | "[" , "]" , type                                          (* empty, `[]int` *)
                  | "[" , "]" , type , "{" , vector_property , { [ "," ] , vector_property } , "}" ;

vector_property = ( "len" | "length" | "init" | "cap" | "capacity" ) , ":" , expression ;
                                              (* valid combinations: `cap` alone, or `len` with `init`, optionally with `cap` *)

index_expression = expression , "[" , expression , "]" ;   (* shared with maps; D-058 for a `[` that starts a new line *)

membership_expression = expression , ( "in" | "not" , "in" ) , expression ;   (* vectors, maps and strings *)

(* === section: map (owner 007) === *)
map_type        = "map" , "[" , type , "," , type , "]" ;

map_expression  = map_type , "{" , [ map_entry , { [ "," ] , map_entry } ] , "}" ;
map_entry       = expression , ":" , expression ;

(* Lookup and assignment use `index_expression` (section vec). *)

(* === section: mod (owner 007) === *)
module_declaration = "module" , IDENT ;       (* first statement of a module file *)

import_statement = "import" , IDENT ;         (* members are then reached as `IDENT :: member` *)

from_import_statement = "from" , IDENT , "import" , IDENT , { [ "," ] , IDENT } ;
                                              (* MOD-4: the reference makes commas optional; the parser still requires them *)

scope_access    = IDENT , "::" , IDENT ;      (* `Module::member`, also `Module::Type { ... }` *)

(* === section: struct (owner 008) === *)
(* pending *)

(* === section: iface (owner 008) === *)
(* pending *)

(* === section: enum (owner 008) === *)
(* pending *)

(* === section: union (owner 008) === *)
(* pending *)

(* === section: gen (owner 008) === *)
(* pending *)

(* === section: err (owner 008) === *)
(* pending *)
