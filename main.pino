enum Primitive {
  String
  Int
  Float
  Bool
  Rune
  Void
  Regex
}

enum Day {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

fn is_float_primitive(entity Primitive) bool {
  return entity == Primitive::Float
}

fn main {
  val res = is_float_primitive(Primitive::Float)
  val is_monday = Day::Monday == Day::Thursday
}